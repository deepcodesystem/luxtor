<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <record id="location_wh" model="stock.location">
        <field name="name">WH</field>
        <field name="usage">view</field>
        <!-- Parent location removed: stock.stock_location_locations not available in Odoo 19 -->
    </record>

    <record id="location_wh_stock" model="stock.location">
        <field name="name">Stock</field>
        <field name="usage">internal</field>
        <field name="location_id" ref="location_wh"/>
    </record>

    <record id="location_wh_remnants" model="stock.location">
        <field name="name">Remnants</field>
        <field name="usage">internal</field>
        <field name="location_id" ref="location_wh"/>
    </record>
</odoo>
