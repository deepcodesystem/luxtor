<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="seq_remnant_fetch_request" model="ir.sequence">
        <field name="name">Remnant Picking Request</field>
        <field name="code">remnant.fetch.request</field>
        <field name="prefix">RPR/</field>
        <field name="padding">5</field>
    </record>

    <record id="rule_day_night" model="remnant.category.rule">
        <field name="name">Day &amp; Night</field>
        <field name="sequence">10</field>
        <field name="orientation">widthwise</field>
        <field name="layer_count">2</field>
        <field name="tolerance">1.5</field>
    </record>
    <record id="rule_translucent" model="remnant.category.rule">
        <field name="name">Translucent</field>
        <field name="sequence">20</field>
        <field name="orientation">widthwise</field>
        <field name="layer_count">1</field>
        <field name="tolerance">1.5</field>
    </record>
    <record id="rule_silhouette" model="remnant.category.rule">
        <field name="name">Silhouette</field>
        <field name="sequence">30</field>
        <field name="orientation">widthwise</field>
        <field name="layer_count">1</field>
        <field name="tolerance">1.5</field>
    </record>
    <record id="rule_blackout" model="remnant.category.rule">
        <field name="name">Blackout</field>
        <field name="sequence">40</field>
        <field name="orientation">widthwise</field>
        <field name="layer_count">1</field>
        <field name="tolerance">1.5</field>
    </record>
    <record id="rule_sunscreen" model="remnant.category.rule">
        <field name="name">Sunscreen</field>
        <field name="sequence">50</field>
        <field name="orientation">both</field>
        <field name="layer_count">1</field>
        <field name="tolerance">1.5</field>
    </record>
</odoo>
