<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_order_form_inherit_remnant_picking" model="ir.ui.view">
        <field name="name">sale.order.form.remnant.picking</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='order_line']/list/field[@name='price_unit']" position="before">
                <field name="remnant_category_rule_id" optional="hide"/>
                <field name="remnant_required_length_m" optional="hide"/>
                <field name="remnant_required_width_m" optional="hide"/>
                <field name="remnant_required_height_m" optional="hide"/>
                <field name="remnant_orientation" optional="hide"/>
                <field name="remnant_required_layer_count" optional="hide"/>
                <field name="remnant_tolerance" optional="hide"/>
                <field name="selected_remnant_id" optional="show"/>
                <button name="action_pick_best_remnant" type="object" icon="fa-scissors" title="Pick Best Remnant"/>
            </xpath>
        </field>
    </record>
</odoo>
