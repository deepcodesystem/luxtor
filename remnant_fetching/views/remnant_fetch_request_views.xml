<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_remnant_fetch_request_tree" model="ir.ui.view">
        <field name="name">remnant.picking.request.tree</field>
        <field name="model">remnant.fetch.request</field>
        <field name="arch" type="xml">
            <list decoration-success="best_remnant_id" decoration-warning="not best_remnant_id">
                <field name="name"/>
                <field name="product_id"/>
                <field name="category_rule_id"/>
                <field name="required_width_m"/>
                <field name="required_height_m"/>
                <field name="tolerance"/>
                <field name="orientation"/>
                <field name="required_layer_count"/>
                <field name="best_remnant_id"/>
                <field name="selected_orientation"/>
                <field name="selected_required_width_m"/>
                <field name="selected_max_width_m"/>
                <field name="selected_required_height_m"/>
                <field name="selected_max_height_m"/>
                <field name="selected_fabric_width_m"/>
                <field name="selected_fabric_height_m"/>
                <field name="selected_fit_area_m"/>
                <field name="result_note"/>
            </list>
        </field>
    </record>

    <record id="view_remnant_fetch_request_form" model="ir.ui.view">
        <field name="name">remnant.picking.request.form</field>
        <field name="model">remnant.fetch.request</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_reserve_best_remnant" type="object" string="Reserve Picked Remnant" invisible="not best_remnant_id"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="category_rule_id"/>
                            <field name="product_id"/>
                            <field name="required_width_m"/>
                            <field name="required_height_m"/>
                            <field name="tolerance"/>
                        </group>
                        <group>
                            <field name="orientation"/>
                            <field name="required_layer_count"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="sale_line_id" readonly="1"/>
                        </group>
                    </group>
                    <group string="Result">
                        <field name="best_remnant_id" readonly="1"/>
                        <field name="selected_orientation" readonly="1"/>
                        <field name="selected_required_width_m" readonly="1"/>
                        <field name="selected_max_width_m" readonly="1"/>
                        <field name="selected_required_height_m" readonly="1"/>
                        <field name="selected_max_height_m" readonly="1"/>
                        <field name="selected_fabric_width_m" readonly="1"/>
                        <field name="selected_fabric_height_m" readonly="1"/>
                        <field name="selected_fit_area_m" readonly="1"/>
                        <field name="result_note" readonly="1"/>
                    </group>
                    <group string="Confirmations">
                        <field name="meets_orientation" readonly="1"/>
                        <field name="meets_layer_requirement" readonly="1"/>
                        <field name="meets_tolerance" readonly="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_remnant_fetch_request" model="ir.actions.act_window">
        <field name="name">Picking Requests</field>
        <field name="res_model">remnant.fetch.request</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
