<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_remnant_category_rule_tree" model="ir.ui.view">
        <field name="name">remnant.category.rule.tree</field>
        <field name="model">remnant.category.rule</field>
        <field name="arch" type="xml">
            <list>
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="product_category_id"/>
                <field name="orientation"/>
                <field name="layer_count"/>
                <field name="tolerance"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <record id="view_remnant_category_rule_form" model="ir.ui.view">
        <field name="name">remnant.category.rule.form</field>
        <field name="model">remnant.category.rule</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="product_category_id"/>
                            <field name="active"/>
                        </group>
                        <group>
                            <field name="orientation"/>
                            <field name="layer_count"/>
                            <field name="tolerance"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_remnant_category_rule" model="ir.actions.act_window">
        <field name="name">Category Rules</field>
        <field name="res_model">remnant.category.rule</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
