<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_remnant_stock_tree" model="ir.ui.view">
        <field name="name">remnant.stock.tree</field>
        <field name="model">remnant.stock</field>
        <field name="arch" type="xml">
            <list decoration-muted="state in ('consumed', 'scrapped')" decoration-warning="state == 'reserved'">
                <field name="name"/>
                <field name="remnant_code"/>
                <field name="product_id"/>
                <field name="fabric_color"/>
                <field name="category_rule_id"/>
                <field name="usable_layer_count"/>
                <field name="dimension_label"/>
                <field name="width_m"/>
                <field name="height_m"/>
                <field name="size_m"/>
                <field name="state"/>
                <field name="location_id"/>
                <field name="reserved_sale_line_id"/>
                <field name="company_id" groups="base.group_multi_company"/>
            </list>
        </field>
    </record>

    <record id="view_remnant_stock_form" model="ir.ui.view">
        <field name="name">remnant.stock.form</field>
        <field name="model">remnant.stock</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_mark_available" type="object" string="Mark Available" invisible="state == 'available'"/>
                    <button name="action_mark_consumed" type="object" string="Mark Consumed" invisible="state == 'consumed'"/>
                    <field name="state" widget="statusbar" statusbar_visible="available,reserved,consumed"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="remnant_code"/>
                            <field name="product_id"/>
                            <field name="fabric_color"/>
                            <field name="category_rule_id"/>
                        </group>
                        <group>
                            <field name="usable_layer_count"/>
                            <field name="width_m"/>
                            <field name="height_m"/>
                            <field name="dimension_label" readonly="1"/>
                            <field name="size_m" readonly="1"/>
                            <field name="location_id"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                    </group>
                    <group>
                        <field name="reserved_sale_line_id" readonly="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_remnant_stock_search" model="ir.ui.view">
        <field name="name">remnant.stock.search</field>
        <field name="model">remnant.stock</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="remnant_code"/>
                <field name="category_rule_id"/>
                <filter name="available" string="Available" domain="[('state','=','available')]"/>
                <filter name="reserved" string="Reserved" domain="[('state','=','reserved')]"/>
                <!--<group expand="0" string="Group By">
                    <filter name="group_category" string="Category" context="{'group_by': 'category_rule_id'}"/>
                    <filter name="group_state" string="State" context="{'group_by': 'state'}"/>
                </group>-->
            </search>
        </field>
    </record>

    <record id="action_remnant_stock" model="ir.actions.act_window">
        <field name="name">Remnant Stock</field>
        <field name="res_model">remnant.stock</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_available': 1}</field>
    </record>
</odoo>
