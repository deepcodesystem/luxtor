<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <!-- Colonnes dims sur la liste des lignes de commande -->
  <record id="view_sale_order_line_lx_dims_tree" model="ir.ui.view">
    <field name="name">sale.order.line.lx_dims.form</field>
    <field name="model">sale.order</field>
    <field name="type">form</field>
    <field name="inherit_id" ref="sale.view_order_form"/>
    <field name="arch" type="xml">
      <xpath expr="//field[@name='order_line']//field[@name='product_template_id']"
             position="after">
        <field name="bom_id" optional="hide" string="BOM"/>
        <field name="lx_width_m" optional="show" string="W (m)"/>
        <field name="lx_height_m" optional="show" string="H (m)"/>
        <field name="size" optional="show" string="Surface (m²)"/>

      </xpath>
       <xpath expr="//field[@name='product_custom_attribute_value_ids']" position="after">
            <field name="lx_control_side" optional="hide" string="Control Side"/>
            <field name="lx_roll_direction" optional="hide" string="Roll Direction"/>
            <field name="lx_fitting_method" optional="hide" string="Fitting Method"/>
        </xpath>
    </field>
  </record>
</odoo>
