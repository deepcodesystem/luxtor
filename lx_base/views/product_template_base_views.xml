<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <!-- Cases Store / Composant à côté de sale_ok -->
  <record id="view_product_template_lx_classification_form" model="ir.ui.view">
    <field name="name">product.template.lx_classification.form</field>
    <field name="model">product.template</field>
    <field name="inherit_id" ref="product.product_template_form_view"/>
    <field name="arch" type="xml">
      <div name="options" position="inside">
        <span name="lx_store_option" class="d-inline-flex ms-3">
          <field name="lx_is_store"/>
          <label for="lx_is_store"/>
        </span>
        <span name="lx_component_option" class="d-inline-flex ms-3">
          <field name="lx_is_component"/>
          <label for="lx_is_component"/>
        </span>
      </div>
    </field>
  </record>

  <!-- Filtres Store / Composant dans la recherche -->
  <record id="view_product_template_lx_classification_search" model="ir.ui.view">
    <field name="name">product.template.lx_classification.search</field>
    <field name="model">product.template</field>
    <field name="inherit_id" ref="product.product_template_search_view"/>
    <field name="arch" type="xml">
      <filter name="filter_to_sell" position="after">
        <filter string="Store" name="lx_is_store" domain="[('lx_is_store', '=', True)]"/>
        <filter string="Composant" name="lx_is_component" domain="[('lx_is_component', '=', True)]"/>
        <separator/>
      </filter>
    </field>
  </record>

  <!-- Onglet "Luxtor" sur product.template -->
  <record id="view_product_template_lx_base_form" model="ir.ui.view">
    <field name="name">product.template.lx_base.form</field>
    <field name="model">product.template</field>
    <field name="inherit_id" ref="product.product_template_form_view"/>
    <field name="arch" type="xml">
      <notebook position="inside">
        <page string="Luxtor" name="lx_base">
          <group string="Dimension Product" invisible="not lx_is_store">
            <field name="is_dimension_product"/>
            <field name="orientation" invisible="not is_dimension_product"/>
            <field name="width_cm" invisible="not is_dimension_product"/>
            <field name="max_height" invisible="not is_dimension_product"/>
            <field name="lx_fabric_ref_id" invisible="not is_dimension_product"/>
          </group>
          <group invisible="not lx_is_component">
            <group string="Component Flags">
              <field name="lx_component_type"/>
              <field name="lx_qty_by_width"/>
              <field name="lx_qty_by_height"/>
            </group>
            <group string="BOM Computation">
              <field name="waste_rate"/>
              <field name="added_margin"/>
              <field name="maximum_load"/>
              <field name="fabric_allowance"/>
              <field name="remenant_threshold"/>
            </group>
            <group string="Fabric / Roller Widths" invisible="lx_component_type != 'fabric'">
              <field name="roller_width_ids" widget="many2many_tags"/>
            </group>
            <group string="Fabric Properties" invisible="lx_component_type != 'fabric'">
              <field name="lx_weight"/>
              <field name="lx_is_day_night"/>
              <field name="openness_factor_id"/>
              <field name="color_fastness_id"/>
              <field name="composition_id"/>
            </group>

          </group>
        </page>
      </notebook>
    </field>
  </record>
</odoo>

