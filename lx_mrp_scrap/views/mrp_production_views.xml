<?xml version="1.0" encoding="utf-8"?>
<odoo>

  <record id="view_mrp_production_lx_scrap_form" model="ir.ui.view">
    <field name="name">mrp.production.lx.scrap.form</field>
    <field name="model">mrp.production</field>
    <field name="inherit_id" ref="mrp.mrp_production_form_view"/>
    <field name="arch" type="xml">

      <!-- Colonne Rouleau dans la liste des composants -->
      <xpath expr="//page[@name='components']//field[@name='lot_ids']" position="after">
        <field name="lx_selected_lot_id"
               optional="show"
               string="Rouleau tissu"/>
        <field name="lx_orientation"
               optional="show"
               string="Sens de coupe"/>
      </xpath>

      <!-- Onglet Chutes -->
      <xpath expr="//notebook" position="inside">
        <page string="Chutes" name="lx_scrap">
          <field name="lx_scrap_ids" nolabel="1">
            <list editable="bottom">
              <field name="name"/>
              <field name="lx_scrap_width"/>
              <field name="lx_scrap_length"/>
              <field name="lx_scrap_area"/>
              <field name="state"/>
            </list>
          </field>
        </page>
      </xpath>

    </field>
  </record>

</odoo>
