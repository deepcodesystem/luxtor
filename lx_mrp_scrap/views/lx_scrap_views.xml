<?xml version="1.0" encoding="utf-8"?>
<odoo>

  <!-- Vue liste (standalone) -->
  <record id="view_lx_scrap_tree" model="ir.ui.view">
    <field name="name">lx.scrap.list</field>
    <field name="model">lx.scrap</field>
    <field name="arch" type="xml">
      <list>
        <field name="name"/>
        <field name="production_id"/>
        <field name="product_id"/>
        <field name="lx_scrap_width"/>
        <field name="lx_scrap_length"/>
        <field name="lx_scrap_area"/>
        <field name="state"/>
      </list>
    </field>
  </record>

  <!-- Vue formulaire -->
  <record id="view_lx_scrap_form" model="ir.ui.view">
    <field name="name">lx.scrap.form</field>
    <field name="model">lx.scrap</field>
    <field name="arch" type="xml">
      <form>
        <sheet>
          <div class="oe_button_box" name="button_box">
            <button name="action_put_in_stock" type="object"
                    class="oe_stat_button"
                    icon="fa-archive"
                    string="Mettre au stock"
                    invisible="state != 'available' or new_lot_id"/>
          </div>
          <group>
            <field name="name"/>
            <field name="production_id"/>
            <field name="lot_id"/>
            <field name="product_id"/>
            <field name="lx_scrap_width"/>
            <field name="lx_scrap_length"/>
            <field name="lx_scrap_area"/>
            <field name="state"/>
            <field name="new_lot_id"/>
          </group>
          <group>
            <field name="notes"/>
          </group>
        </sheet>
      </form>
    </field>
  </record>

  <!-- Vue recherche -->
  <record id="view_lx_scrap_search" model="ir.ui.view">
    <field name="name">lx.scrap.search</field>
    <field name="model">lx.scrap</field>
    <field name="arch" type="xml">
      <search>
        <filter name="available" string="Disponible"
                domain="[('state', '=', 'available')]"/>
        <filter name="used" string="Utilisée"
                domain="[('state', '=', 'used')]"/>
        <filter name="discarded" string="Rebutée"
                domain="[('state', '=', 'discarded')]"/>
        <separator/>
        <filter name="reutilisable" string="Chute réutilisable"
                domain="[('lot_id.lx_is_scrap', '=', True)]"/>
      </search>
    </field>
  </record>

  <!-- Action -->
  <record id="action_lx_scrap" model="ir.actions.act_window">
    <field name="name">Chutes</field>
    <field name="res_model">lx.scrap</field>
    <field name="view_mode">list,form</field>
    <field name="search_view_id" ref="view_lx_scrap_search"/>
    <field name="help">
      Liste des chutes de tissu générées lors de la production.
    </field>
  </record>

</odoo>
