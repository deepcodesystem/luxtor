<?xml version="1.0" encoding="utf-8"?>
<odoo>

  <record id="view_stock_lot_lx_form_inherit" model="ir.ui.view">
    <field name="name">stock.lot.lx.scrap.form</field>
    <field name="model">stock.lot</field>
    <field name="inherit_id" ref="stock.view_production_lot_form"/>
    <field name="arch" type="xml">

      <xpath expr="//sheet" position="inside">
        <notebook>
          <page string="Rouleau tissu" name="lx_fabric_roll">
            <group>
              <field name="lx_width"/>
              <field name="lx_is_scrap"/>
              <field name="lx_origin_production_id"/>
            </group>
          </page>
        </notebook>
      </xpath>

    </field>
  </record>

</odoo>
