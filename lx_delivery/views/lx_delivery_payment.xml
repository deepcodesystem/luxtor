<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Remplacement du bloc payment_method standard par 2 options radio custom -->
    <template id="lx_delivery_payment_terms" inherit_id="website_sale.payment">
        <xpath expr="//div[@id='payment_method']" position="replace">
            <div id="payment_method" class="lx-payment-wrap">

                <!-- Panneau sécurité paiement -->
                <div class="lx-payment-offer-wrap mb-3">
                    <div class="lx-payment-offer-box p-3 rounded border bg-light">
                        <div class="d-flex align-items-center gap-2">
                            <span class="text-success fs-5">🔒</span>
                            <span class="small">Paiement 100% sécurisé par carte bancaire.</span>
                        </div>
                    </div>
                </div>

                <h5 class="mb-3">Mode de paiement</h5>

                <div class="lx-payment-form">
                    <!-- Option 100% upfront -->
                    <div class="lx-payment-group mb-3">
                        <div class="lx-payment-radio d-flex align-items-start gap-3">
                            <input type="radio" name="lx_payment_terms" id="lx_pay_upfront"
                                   value="upfront"
                                   t-att-checked="lx_payment_choice == 'upfront' and 'checked' or None"
                                   class="form-check-input mt-1"/>
                            <div class="lx-payment-card flex-fill p-3 rounded border">
                                <div class="lx-payment-card-body">
                                    <div class="lx-payment-title fw-semibold">100% à la commande</div>
                                    <div class="lx-payment-subtitle text-muted small">
                                        Paiement intégral par Carte Bancaire au moment de la commande.
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Option 50/50 -->
                    <div class="lx-payment-group mb-3">
                        <div class="lx-payment-radio d-flex align-items-start gap-3">
                            <input type="radio" name="lx_payment_terms" id="lx_pay_half"
                                   value="half_half"
                                   t-att-checked="lx_payment_choice == 'half_half' and 'checked' or None"
                                   class="form-check-input mt-1"/>
                            <div class="lx-payment-card flex-fill p-3 rounded border">
                                <div class="lx-payment-card-body">
                                    <div class="lx-payment-title fw-semibold">
                                        50% à la commande &amp; 50% à la livraison
                                    </div>
                                    <div class="lx-payment-subtitle text-muted small">
                                        Premier versement par Carte Bancaire, solde à la livraison.
                                    </div>
                                    <t t-if="lx_payment_summary and lx_payment_choice == 'half_half'">
                                        <div class="mt-2 text-dark small">
                                            Maintenant :
                                            <strong>
                                                <t t-esc="lx_payment_summary.get('amount_now', 0)"/>
                                                <t t-esc="lx_payment_summary.get('currency_symbol', '')"/>
                                            </strong>
                                            — À la livraison :
                                            <strong>
                                                <t t-esc="lx_payment_summary.get('amount_later', 0)"/>
                                                <t t-esc="lx_payment_summary.get('currency_symbol', '')"/>
                                            </strong>
                                        </div>
                                    </t>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

            </div>
        </xpath>
    </template>

</odoo>

