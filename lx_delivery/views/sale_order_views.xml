<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <!-- ── Inherit sale.order form ───────────────────────────────── -->
        <record id="view_sale_order_lx_delivery_inherit" model="ir.ui.view">
            <field name="name">sale.order.lx.delivery.inherit</field>
            <field name="model">sale.order</field>
            <field name="inherit_id" ref="sale.view_order_form"/>
            <field name="arch" type="xml">
                <xpath expr="//notebook" position="inside">
                    <page string="Shipping" name="lx_shipping_page">
                        <group>
                            <group string="Method">
                                <field name="shipping_method_type"/>
                                <field name="shipping_city_id"
                                       invisible="shipping_method_type != 'standard'"
                                       options="{'no_create': True}"/>
                                <field name="shipping_price" readonly="1"/>
                            </group>
                            <group string="Payment">
                                <field name="lx_payment_terms"/>
                            </group>
                        </group>
                        <div class="oe_chatter_divider"/>
                        <div>
                            <button name="action_lx_open_shipping_wizard"
                                    string="Add / Update Shipping"
                                    type="object"
                                    class="btn btn-secondary"/>
                        </div>
                    </page>
                </xpath>
            </field>
        </record>

    </data>
</odoo>

