<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>
        <record id="view_sale_order_shipping_wizard_form" model="ir.ui.view">
            <field name="name">sale.order.shipping.wizard.form</field>
            <field name="model">sale.order.shipping.wizard</field>
            <field name="arch" type="xml">
                <form string="Add Shipping" create="false" edit="false">
                    <sheet>
                        <group>
                            <field name="currency_id" invisible="1"/>
                            <field name="shipping_method" widget="radio"
                                   options="{'horizontal': true}"/>
                            <field name="city_id"
                                   string="City / Zone"
                                   options="{'no_create': True}"
                                   invisible="shipping_method != 'standard'"
                                   required="shipping_method == 'standard'"/>
                            <field name="price"
                                   string="Computed Price"
                                   widget="monetary"
                                   options="{'currency_field': 'currency_id'}"
                                   readonly="1"/>
                            <field name="free_note" readonly="1" nolabel="1" invisible="not free_note"/>
                            <field name="is_free" invisible="1"/>
                        </group>
                        <div class="alert alert-success mt-3 mb-0" invisible="not is_free">
                            La livraison est offerte pour cette commande car le total éligible a atteint le seuil configuré.
                        </div>
                        <footer>
                            <button string="Confirm" type="object" name="action_confirm"
                                    class="btn btn-primary"/>
                            <button string="Discard" class="btn btn-secondary" special="cancel"/>
                        </footer>
                    </sheet>
                </form>
            </field>
        </record>

        <record id="action_sale_order_shipping_wizard" model="ir.actions.act_window">
            <field name="name">Add Shipping</field>
            <field name="res_model">sale.order.shipping.wizard</field>
            <field name="view_mode">form</field>
            <field name="target">new</field>
            <field name="context">{'active_id': active_id}</field>
        </record>
    </data>
</odoo>

