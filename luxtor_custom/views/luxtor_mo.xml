<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <record id="view_mrp_production_form_lx" model="ir.ui.view">
    <field name="name">mrp.production.form.custom_lx</field>
    <field name="model">mrp.production</field>
    <field name="inherit_id" ref="mrp.mrp_production_form_view"/>
    <field name="arch" type="xml">

      <xpath expr="//div[@name='bom_div']" position="after"> 
          <field name="luxtor_location_id" />
          <field name="lx_width_m" />
          <field name="lx_height_m" />
      </xpath>

      <xpath expr="//field[@name='user_id']" position="after">
          <field name="x_control_side" widget="radio" options="{'horizontal': true}"/>
          <field name="x_roll_direction" widget="radio" options="{'horizontal': true}"/>
          <field name="x_fitting_method" widget="radio" options="{'horizontal': true}"/>
          <field name="waste_main_id"
                       string="Waste Processing"/>
      </xpath>

      <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_view_waste"
                        type="object"
                        class="oe_stat_button"
                        string="Waste"
                        icon="fa-recycle">
                    <field name="waste_ids" widget="statinfo"/>
                </button>
      </xpath>

      <xpath expr="//page[@name='components']/field[@name='move_raw_ids']/list/field[@name='product_uom']" position="after">
        <field name="location_id" optional="show"/>
        <field name="lx_candidate_lot_id" optional="show"/>
        <field name="lx_candidate_lot_ids"
              widget="many2many_tags"
              optional="show" column_invisible="True"/>
         <field name="lx_bom_uom_qty" optional="show"/>
        <field name="lx_unit_price" optional="show"/>
        <field name="lx_waste_rate" optional="show" column_invisible="True"/>
        <field name="lx_added_margin" optional="show" column_invisible="True"/>
        <field name="lx_cost_price" optional="show" widget="monetary" sum="Total"/>
        <field name="lx_amount" optional="show" widget="monetary" sum="Total"/>
        <field name="lx_mo_width_m" column_invisible="True"/>
        <field name="lx_mo_height_m" column_invisible="True"/>
        <field name="currency_id"/>
      </xpath>

    </field>
  </record>

