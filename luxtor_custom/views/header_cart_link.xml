<odoo>
    <template id="header_cart_link_full_replace" inherit_id="website_sale.header_cart_link">
        <xpath expr="//t[@t-name='website_sale.header_cart_link']" position="replace">
            <t name="Header Cart Link" t-name="website_sale.header_cart_link"
               t-nocache="The number of products is dynamic, this rendering cannot be cached."
               t-nocache-_icon="_icon"
               t-nocache-_text="_text"
               t-nocache-_badge="_badge"
               t-nocache-_badge_class="_badge_class"
               t-nocache-_icon_wrap_class="_icon_wrap_class"
               t-nocache-_text_class="_text_class"
               t-nocache-_item_class="_item_class"
               t-nocache-_link_class="_link_class">

                <t t-set="website_sale_cart_quantity"
                   t-value="request.session.get('website_sale_cart_quantity', request.cart.cart_quantity) or 0"/>
                <t t-set="show_cart" t-value="website.has_ecommerce_access()"/>

                <li t-attf-class="#{_item_class} divider d-none"/>

                <!-- CART -->
                <li t-attf-class="o_wsale_my_cart #{not show_cart and 'd-none'} #{_item_class}">
                    <a href="/shop/cart" t-attf-class="#{_link_class}" aria-label="Panier eCommerce">
                        <div t-attf-class="#{_icon_wrap_class}">
                            <i t-if="_icon" class="fa fa-shopping-cart fa-stack"/>
                            <sup t-attf-class="my_cart_quantity badge bg-primary #{_badge_class} #{'d-none' if (website_sale_cart_quantity == 0) else ''}"
                                 t-out="website_sale_cart_quantity"
                                 t-att-data-order-id="request.session.get('sale_order_id', None) if website_sale_cart_quantity else None"/>
                        </div>
                        <span t-if="_text" t-attf-class="#{_text_class}">Mon panier</span>
                    </a>
                </li>

                <!-- TRACKING -->
                <li t-attf-class="#{_item_class} o_wsale_track_order">
                    <a href="/suivi-de-commande" t-attf-class="#{_link_class}" aria-label="Suivi de commande">
                        <div t-attf-class="#{_icon_wrap_class} lx_track_wrap">
                            <svg xmlns="http://www.w3.org/2000/svg"
                                 viewBox="0 0 256 256"
                                 class="lx_track_svg"
                                 fill="none"
                                 stroke="currentColor"
                                 stroke-width="20"
                                 stroke-linecap="round"
                                 stroke-linejoin="round"
                                 aria-hidden="true">
                                <path d="M128 240 C128 240 208 160 208 104 C208 55 168 16 128 16 C88 16 48 55 48 104 C48 160 128 240 128 240 Z"/>
                                <path d="M128 68 L172 92 L128 116 L84 92 Z"/>
                                <path d="M84 92 L128 116 V168 L84 144 Z"/>
                                <path d="M172 92 L128 116 V168 L172 144 Z"/>
                            </svg>
                        </div>
                        <span t-if="_text" t-attf-class="#{_text_class}">Suivi</span>
                    </a>
                </li>

            </t>
        </xpath>
    </template>
</odoo>
