<?xml version="1.0" encoding="utf-8"?>
<odoo>

<template id="luxtor_cart_express" inherit_id="website_sale.cart" name="Cart Express Option">
    <data inherit_id="website_sale.cart" name="Cart Express Option">
<xpath expr="//t[@t-call='website_sale.cart_lines']/following-sibling::div[@class='clearfix']" position="before">
      

<!-- establish order context on product page -->
    <t t-set="website_sale_order" t-value="request.website.sale_get_order()"/>
    <t t-set="lx_limit" t-value="float(request.env['ir.config_parameter'].sudo().get_param('luxtor.lx_order_limit_amount', '0') or 0.0)"/>
    <t t-set="lx_required" t-value="bool(website_sale_order) and (website_sale_order.amount_total &gt;= lx_limit)"/>
    <t t-set="lx_ok" t-value="(website_sale_order and website_sale_order._fields.get('lx_verification_ok') and website_sale_order.lx_verification_ok) or False"/>

  <t t-if="lx_required and not lx_ok">
  <div id="lx-limit-root" class="lx-verif-wrap" t-att-data-lx-limit="lx_limit" data-lx-scope="product" data-helpdesk-url="https://31.97.193.122/helpdesk/customer-care-1" style="max-width: 680px; margin:16px auto 22px auto;">

    <t t-if="request.session.get('lx_msg_ok')">
      <div class="alert alert-success mb-2" t-out="request.session.pop('lx_msg_ok')"/>
    </t>
    <t t-if="request.session.get('lx_msg_err')">
      <div class="alert alert-danger mb-2" t-out="request.session.pop('lx_msg_err')"/>
    </t>

    <!-- Warning message -->
    <div id="lx-limit-msg" class="alert alert-warning mb-3 text-start">
      Your order exceeds the allowed limit. To continue, please request an authorization code to complete your purchase.
    </div>

    <!-- Continue button (same style as Checkout) -->
    <div class="d-grid mb-3">
      <button id="lx-helpdesk-btn" type="button" class="btn btn-secondary o_wsale_btn_checkout w-100">
        Click to Continue
      </button>
    </div>

    <!-- Code validation form (hidden by default) -->
    <form id="lx-validate-form" action="/shop/order/validate_code" method="post" class="d-none" novalidate="novalidate">
      <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
      <div class="input-group">
        <input id="lx-code-input" class="form-control" type="text" name="lx_code" placeholder="Enter your code" aria-label="Authorization code" required="required"/>
        <button id="lx-validate-btn" type="submit" class="btn btn-secondary">
          Validate
        </button>
      </div>
    </form>
  </div>

  <script type="text/javascript">
    (function () {
      const root = document.getElementById('lx-limit-root');
      if (!root) return;
      const btn = root.querySelector('#lx-helpdesk-btn');
      const form = root.querySelector('#lx-validate-form');
      const helpdeskUrl = root.dataset.helpdeskUrl;
      btn?.addEventListener('click', function () {
        try { window.open(helpdeskUrl, '_blank'); } catch(e) {}
        form?.classList.remove('d-none');
        form?.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
      });
    })();
  </script>

<style>
  #lx-limit-root #lx-limit-msg {
    font-size: .95rem;
    line-height: 1.4;
    border-radius: .5rem;
  }
  
  #lx-limit-root #lx-code-input {
    padding: .55rem .75rem;
    font-size: .95rem;
    border-radius: .5rem 0 0 .5rem;
  }
  #lx-limit-root .o_wsale_btn_checkout,
#lx-limit-root #lx-validate-btn {
  display: inline-block;
  background-color: #2e3235;   /* dark background */
  color: #fff;                 /* white text */
  text-transform: uppercase;   /* all caps */
  font-weight: 300;
  font-size: .9rem;
  letter-spacing: 1px;         /* spacing like in SUBMIT TICKET */
  padding: 0.75rem 1.5rem;     /* balanced size */
  border: none;                /* remove border */
  border-radius: 0;            /* no rounded corners */
  cursor: pointer;
  text-align: center;
}

#lx-limit-root .o_wsale_btn_checkout:hover,
#lx-limit-root #lx-validate-btn:hover {
  background-color: #1f2224;   /* slightly darker on hover */
}
</style>
</t>

    </xpath>

</data>

</template> 





</odoo>
