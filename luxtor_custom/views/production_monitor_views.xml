    <!-- ==============================
         Production Sheet Report Template
         ============================== -->

   <template id="report_production_sheet_document">

  <t t-set="fabric_move"
     t-value="(mo and mo._lx_find_fabric_move and mo._lx_find_fabric_move()) or False"/>

  <t t-set="workorder"
     t-value="(o and ('workorder_id' in o._fields) and o.workorder_id)
              or (mo and ('workorder_ids' in mo._fields) and mo.workorder_ids and mo.workorder_ids[:1])
              or False"/>

  <t t-set="line_no"
     t-value="(o and ('line_no' in o._fields) and o.line_no) or False"/>

  <t t-set="so"
     t-value="(mo and ('sale_line_id' in mo._fields) and mo.sale_line_id and mo.sale_line_id.order_id)
              or (o and ('sale_order_id' in o._fields) and o.sale_order_id)
              or False"/>

  <t t-set="source_doc"
     t-value="(so and so.name)
              or (mo and ('origin' in mo._fields) and mo.origin)
              or ''"/>

  <t t-set="purchase_date"
     t-value="(mo and ('date_start' in mo._fields) and mo.date_start)
              or (mo and ('create_date' in mo._fields) and mo.create_date)
              or False"/>

  <t t-set="rows_max" t-value="8"/>
  <t t-set="raw_moves_all" t-value="(mo and mo.move_raw_ids) or []"/>
  <t t-set="raw_moves"
     t-value="[m for m in raw_moves_all if not (fabric_move and m.id == fabric_move.id)]"/>

  <t t-set="fabric_src_loc"
     t-value="(fabric_move and ('location_id' in fabric_move._fields) and fabric_move.location_id) or False"/>

  <t t-set="waste_main"
     t-value="(mo and ('waste_main_id' in mo._fields) and mo.waste_main_id) or False"/>

  <t t-set="fabric_lot"
     t-value="(fabric_move and ('lx_candidate_lot_id' in fabric_move._fields) and fabric_move.lx_candidate_lot_id)
              or (fabric_move and ('restrict_lot_id' in fabric_move._fields) and fabric_move.restrict_lot_id)
              or (fabric_move and fabric_move.move_line_ids and fabric_move.move_line_ids[:1].lot_id)
              or False"/>

  <style>
    .lx-page{ font-family: Inter, -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Arial, sans-serif; font-size:12px; color:#111827; }
    .lx-h1{ font-size:16px; font-weight:700; margin:0 0 10px 0; letter-spacing:.2px; }
    .lx-muted{ color:#6b7280; }
    .lx-t{ width:100%; border-collapse:collapse; table-layout:fixed; }
    .lx-t td, .lx-t th{ padding:8px 10px; vertical-align:middle; }
    .lx-t tr + tr td, .lx-t tr + tr th{ border-top:1px solid #e5e7eb; }
    .lx-k{ width:22%; color:#374151; font-weight:600; }
    .lx-v{ color:#111827; }
    .lx-sec{ margin-top:14px; }
    .lx-sec-title{
      font-weight:700; color:#111827; font-size:12px;
      padding:10px 0 6px 0; border-bottom:1px solid #e5e7eb;
      margin:0 0 8px 0;
    }
    .lx-grid{ width:100%; border-collapse:collapse; table-layout:fixed; }
    .lx-grid td{ width:50%; vertical-align:top; padding:0; }
    .lx-grid td:first-child{ padding-right:10px; }
    .lx-grid td:last-child{ padding-left:10px; }
    .lx-sub{ width:100%; border-collapse:collapse; table-layout:fixed; }
    .lx-sub th{
      text-align:left; font-weight:700; color:#374151;
      padding:8px 10px; background:#f9fafb;
      border-bottom:1px solid #e5e7eb;
    }
    .lx-sub td{ padding:8px 10px; }
    .lx-sub tr + tr td{ border-top:1px solid #eef2f7; }
    .lx-pill{
      display:inline-block; padding:2px 8px; border-radius:999px;
      background:#f3f4f6; color:#111827; font-weight:600; font-size:11px;
    }
    .lx-linkish{ color:#2563eb; font-weight:700; }
    .lx-nowrap{ white-space:nowrap; }
  </style>

  <div class="lx-page">

    <div class="lx-h1">Production Sheet</div>

    <table class="lx-t">
      <colgroup>
        <col style="width:22%"/>
        <col style="width:28%"/>
        <col style="width:22%"/>
        <col style="width:28%"/>
      </colgroup>

      <tr>
        <td class="lx-k lx-nowrap">Purchase Date</td>
        <td class="lx-v">
          <t t-if="purchase_date">
            <t t-esc="context_timestamp(purchase_date).strftime('%Y-%m-%d')"/>
          </t>
          <t t-else=""> </t>
        </td>
        <td class="lx-k lx-nowrap"> </td>
        <td class="lx-v"> </td>
      </tr>

      <tr>
        <td class="lx-k lx-nowrap">Manufacturing Order</td>
        <td class="lx-v">
          <t t-if="mo and mo.name"><span class="lx-pill" t-esc="mo.name"/></t>
          <t t-else=""> </t>
        </td>
        <td class="lx-k lx-nowrap"> </td>
        <td class="lx-v"> </td>
      </tr>

      <tr>
        <td class="lx-k lx-nowrap">Source Document</td>
        <td class="lx-v">
          <t t-if="source_doc"><t t-esc="source_doc"/></t>
          <t t-else=""> </t>
        </td>
        <td class="lx-k lx-nowrap"> </td>
        <td class="lx-v"> </td>
      </tr>

      <tr>
        <td class="lx-k lx-nowrap">Product</td>
        <td class="lx-v">
          <t t-if="mo and mo.product_id and mo.product_id.display_name">
            <span class="lx-linkish" t-esc="mo.product_id.display_name"/>
          </t>
          <t t-else=""> </t>
        </td>

        <td class="lx-k lx-nowrap">Work Order</td>
        <td class="lx-v">
          <t t-if="line_no"><span class="lx-pill" t-esc="line_no"/></t>
          <t t-else=""> </t>
        </td>
      </tr>

      <tr>
        <td class="lx-k lx-nowrap">Width</td>
        <td class="lx-v">
          <t t-if="mo and ('lx_width_m' in mo._fields)">
            <span class="lx-linkish" t-esc="('%.2f' % (mo.lx_width_m or 0.0))"/>
          </t>
          <t t-else=""> </t>
        </td>

        <td class="lx-k lx-nowrap">Scheduled Date</td>
        <td class="lx-v">
          <t t-if="so and ('delivery_date' in so._fields) and so.delivery_date">
            <t t-if="isinstance(so.delivery_date, datetime.datetime)">
              <t t-esc="context_timestamp(so.delivery_date).strftime('%d/%m/%Y')"/>
            </t>
            <t t-else="">
              <t t-esc="so.delivery_date.strftime('%d/%m/%Y')"/>
            </t>
          </t>

        </td>
      </tr>

      <tr>
        <td class="lx-k lx-nowrap">Height</td>
        <td class="lx-v">
          <t t-if="mo and ('lx_height_m' in mo._fields)">
            <span class="lx-linkish" t-esc="('%.2f' % (mo.lx_height_m or 0.0))"/>
          </t>
          <t t-else=""> </t>
        </td>

        <td class="lx-k lx-nowrap">Responsible</td>
        <td class="lx-v">
          <t t-if="so and ('lx_salesperson_id' in so._fields) and so.lx_salesperson_id">
            <t t-esc="so.lx_salesperson_id.name"/>
          </t>
          <t t-elif="so and ('user_id' in so._fields) and so.user_id">
            <t t-esc="so.user_id.name"/>
          </t>
          <t t-else=""> </t>
        </td>
      </tr>
    </table>

    <div class="lx-sec">
      <table class="lx-grid">
        <tr>
          <td>
            <div class="lx-sec-title">Product Assembly List</div>
            <table class="lx-sub">
              <colgroup>
                <col style="width:60%"/>
                <col style="width:20%"/>
                <col style="width:20%"/>
              </colgroup>
              <thead>
                <tr>
                  <th>Component</th>
                  <th>Quantity</th>
                  <th>Override</th>
                </tr>
              </thead>
              <tbody>
                <t t-foreach="range(rows_max)" t-as="i">
                  <t t-set="mv" t-value="raw_moves[i] if i &lt; len(raw_moves) else False"/>
                  <tr>
                    <td>
                      <t t-if="mv">
                        <t t-esc="(mv.product_id and mv.product_id.display_name) or (mv.name or '')"/>
                      </t>
                      <t t-else=""> </t>
                    </td>
                    <td>
                      <t t-if="mv">
                        <t t-esc="('%.2f' % (mv.product_uom_qty or 0.0)).replace('.', ',')"/>
                      </t>
                      <t t-else=""> </t>
                    </td>
                    <td class="lx-muted"> </td>
                  </tr>
                </t>
              </tbody>
            </table>
          </td>

          <td>
            <div class="lx-sec-title">Workshop Guidelines</div>
            <table class="lx-sub">
              <colgroup>
                <col style="width:35%"/>
                <col style="width:35%"/>
                <col style="width:30%"/>
              </colgroup>
              <thead>
                <tr>
                  <th>Type</th>
                  <th>Detail</th>
                  <th>Remarks</th>
                </tr>
              </thead>
              <tbody>
                <tr>
                  <td>Warehouse</td>
                  <td><t t-if="fabric_src_loc"><t t-esc="fabric_src_loc.display_name"/></t></td>
                  <td class="lx-muted"> </td>
                </tr>
                <tr>
                  <td>Remnant</td>
                  <td><t t-if="waste_main"><t t-esc="waste_main.display_name"/></t></td>
                  <td class="lx-muted"> </td>
                </tr>
                <tr>
                  <td>Lot No.</td>
                  <td><t t-if="fabric_lot"><t t-esc="fabric_lot.name"/></t></td>
                  <td class="lx-muted"> </td>
                </tr>
                <tr>
                  <td>Roll Width</td>
                  <td><t t-if="mo and ('lx_roll_width_best' in mo._fields)"><t t-esc="('%.2f' % (mo.lx_roll_width_best or 0.0))"/></t></td>
                  <td class="lx-muted"> </td>
                </tr>
                <tr>
                  <td>Orientation</td>
                  <td><t t-if="mo and ('lx_orientation' in mo._fields)"><t t-esc="mo.lx_orientation"/></t></td>
                  <td class="lx-muted"> </td>
                </tr>
                <tr><td> </td><td> </td><td> </td></tr>
                <tr>
                  <td>Control Side</td>
                  <td><t t-if="mo and ('x_control_side' in mo._fields)"><t t-esc="mo.x_control_side"/></t></td>
                  <td class="lx-muted"> </td>
                </tr>
                <tr>
                  <td>Roll Direction</td>
                  <td><t t-if="mo and ('x_roll_direction' in mo._fields)"><t t-esc="mo.x_roll_direction"/></t></td>
                  <td class="lx-muted"> </td>
                </tr>
                <tr>
                  <td>Fitting Method</td>
                  <td><t t-if="mo and ('x_fitting_method' in mo._fields)"><t t-esc="mo.x_fitting_method"/></t></td>
                  <td class="lx-muted"> </td>
                </tr>
              </tbody>
            </table>
          </td>
        </tr>
      </table>
    </div>

    <div class="lx-sec">
      <table class="lx-grid">
        <tr>
          <td>
            <div class="lx-sec-title">Post-Consumption Stock</div>
            <table class="lx-sub">
              <colgroup>
                <col style="width:34%"/>
                <col style="width:33%"/>
                <col style="width:33%"/>
              </colgroup>
              <thead>
                <tr>
                  <th>Type</th>
                  <th>To Consume</th>
                  <th>Remnant</th>
                </tr>
              </thead>
              <tbody>
                <tr><td>Width</td><td class="lx-muted"> </td><td class="lx-muted"> </td></tr>
                <tr><td>Height</td><td class="lx-muted"> </td><td class="lx-muted"> </td></tr>
              </tbody>
            </table>
          </td>

          <td>
            <div class="lx-sec-title">Offcut Stock</div>
            <table class="lx-sub">
              <colgroup>
                <col style="width:34%"/>
                <col style="width:33%"/>
                <col style="width:33%"/>
              </colgroup>
              <thead>
                <tr>
                  <th>Type</th>
                  <th>Scrap</th>
                  <th>Roll End</th>
                </tr>
              </thead>
              <tbody>
                <tr><td>Width</td><td class="lx-muted"> </td><td class="lx-muted"> </td></tr>
                <tr><td>Height</td><td class="lx-muted"> </td><td class="lx-muted"> </td></tr>
              </tbody>
            </table>
          </td>
        </tr>
      </table>
    </div>

  </div>
</template>

    <!-- Report Action -->
    <record id="action_report_lx_delivery_note" model="ir.actions.report">
        <field name="name">Delivery Note</field>
        <field name="model">luxtor.production.monitor.line</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">luxtor_custom.report_lx_delivery_note</field>
        <field name="report_file">luxtor_custom.report_lx_delivery_note</field>
        <field name="print_report_name">'Delivery Note - %s' % (object.sale_order_id.name or object.mo_ref or '')</field>
        <field name="binding_model_id" ref="model_luxtor_production_monitor_line"/>
        <field name="binding_type">report</field>
    </record>

    <!-- QWeb Template -->
<template id="report_lx_delivery_note">
  <t t-call="web.basic_layout">

    <t t-foreach="docs" t-as="doc">

      <!-- Prepared dict per doc -->
      <t t-set="p" t-value="prepared_map.get(doc.id) or {}"/>
      <t t-set="so" t-value="p.get('so')"/>
      <t t-set="partner" t-value="p.get('partner')"/>
      <t t-set="currency" t-value="p.get('currency')"/>
      <t t-set="carrier_name" t-value="p.get('carrier_name') or ''"/>
      <t t-set="total_packages" t-value="p.get('total_packages') or 0"/>
      <t t-set="shipping_cost" t-value="p.get('shipping_cost') or 0.0"/>
      <t t-set="cod_amount" t-value="p.get('cod_amount') or 0.0"/>
      <t t-set="order_lines" t-value="p.get('order_lines') or env['sale.order.line']"/>
      <t t-set="release_date" t-value="p.get('release_date')"/>

      <style type="text/css">
        .lx_dn_wrap { font-size: 12px; }
        .lx_dn_title { font-size: 16px; font-weight: 700; margin-bottom: 10px; }
        .lx_dn_grid { width: 100%; border-collapse: collapse; }
        .lx_dn_grid td { vertical-align: top; padding: 2px 6px; }
        .lx_dn_label { color: #444; font-weight: 700; }
        .lx_dn_value { color: #1f4e79; font-weight: 700; }
        .lx_dn_box { border: 1px solid #ddd; padding: 10px; border-radius: 8px; }
        .lx_dn_table { width: 100%; border-collapse: collapse; margin-top: 12px; }
        .lx_dn_table th { background: #f2f2f2; padding: 8px; border: 1px solid #ddd; text-align: left; }
        .lx_dn_table td { padding: 8px; border: 1px solid #ddd; }
        .right { text-align: right; }
      </style>

      <div class="page">
        <div class="lx_dn_wrap">

          <div class="lx_dn_title">Delivery Note</div>

          <table class="lx_dn_grid">
            <tr>

              <td style="width: 55%;">
                <div class="lx_dn_box">
                  <table class="lx_dn_grid">

                    <tr>
                      <td class="lx_dn_label" style="width: 40%;">Release Date</td>
                      <td class="lx_dn_value">
                        <t t-if="release_date">
                          <t t-esc="release_date"/>
                        </t>
                        <t t-else="">
                          <t t-esc="fields.Date.context_today(doc)"/>
                        </t>
                      </td>
                    </tr>

                    <tr>
                      <td class="lx_dn_label">Source Document</td>
                      <td class="lx_dn_value">
                        <t t-esc="so.name if so else ''"/>
                      </td>
                    </tr>

                    <tr><td colspan="2" style="height: 8px;"></td></tr>

                    <tr>
                      <td class="lx_dn_label">Contact</td>
                      <td class="lx_dn_value">
                        <t t-esc="partner.name if partner else ''"/>
                      </td>
                    </tr>

                    <tr>
                      <td></td>
                      <td class="lx_dn_value">
                        <t t-esc="partner.street if (partner and partner.street) else ''"/>
                        <t t-if="partner and partner.street2">, <t t-esc="partner.street2"/></t>
                      </td>
                    </tr>

                    <tr>
                      <td></td>
                      <td class="lx_dn_value">
                        <t t-esc="partner.city if (partner and partner.city) else ''"/>
                        <t t-if="partner and partner.zip">, <t t-esc="partner.zip"/></t>
                      </td>
                    </tr>

                    <tr>
                      <td></td>
                      <td class="lx_dn_value">
                        <t t-esc="(partner.phone or partner.mobile) if partner else ''"/>
                      </td>
                    </tr>

                  </table>
                </div>
              </td>

              <td style="width: 45%;">
                <div class="lx_dn_box">
                  <table class="lx_dn_grid">

                    <tr>
                      <td class="lx_dn_label" style="width: 55%;">Carrier</td>
                      <td class="lx_dn_value">
                        <t t-esc="carrier_name"/>
                      </td>
                    </tr>

                    <tr>
                      <td class="lx_dn_label">Total Packages</td>
                      <td class="lx_dn_value">
                        <t t-esc="total_packages"/>
                      </td>
                    </tr>

                    <tr>
                      <td class="lx_dn_label">Shipping Cost</td>
                      <td class="lx_dn_value">
                        <t t-if="currency">
                          <span t-esc="shipping_cost" t-options="{'widget':'monetary','display_currency':currency}"/>
                        </t>
                        <t t-else="">
                          <span t-esc="shipping_cost"/>
                        </t>
                      </td>
                    </tr>

                    <tr>
                      <td class="lx_dn_label">COD Amount</td>
                      <td class="lx_dn_value">
                        <t t-if="currency">
                          <span t-esc="cod_amount" t-options="{'widget':'monetary','display_currency':currency}"/>
                        </t>
                        <t t-else="">
                          <span t-esc="cod_amount"/>
                        </t>
                      </td>
                    </tr>

                  </table>
                </div>
              </td>

            </tr>
          </table>

          <table class="lx_dn_table">
            <thead>
              <tr>
                <th style="width: 18%;">Package No.</th>
                <th>Product</th>
                <th style="width: 18%;" class="right">Quantity</th>
              </tr>
            </thead>

            <tbody>
              <t t-set="idx" t-value="0"/>

              <t t-foreach="order_lines" t-as="l">
                <t t-set="idx" t-value="idx + 1"/>
                <tr>
                  <td><t t-esc="idx"/></td>
                  <td><t t-esc="l.product_id.display_name or l.name or ''"/></td>
                  <td class="right"><t t-esc="l.product_uom_qty"/></td>
                </tr>
              </t>

              <t t-if="not order_lines">
                <tr>
                  <td colspan="3">No products found on Sales Order.</td>
                </tr>
              </t>
            </tbody>
          </table>

        </div>
      </div>

    </t>
  </t>
</template>




    

</odoo>
