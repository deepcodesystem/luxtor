<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Action: Production Monitor -->
    <record id="action_luxtor_production_monitor" model="ir.actions.act_window">
        <field name="name">Production Monitor</field>
        <field name="res_model">luxtor.production.monitor</field>
        <field name="view_mode">list,form</field>
        <field name="context">{}</field>
        <field name="domain">[]</field>
    </record>

    <!-- Menu under Manufacturing / Operations -->
    <menuitem id="menu_luxtor_production_monitor"
              name="Production Monitor"
              parent="mrp.menu_mrp_manufacturing"
              action="action_luxtor_production_monitor"
              sequence="25"/>

    <!-- Monitor list -->
    <record id="view_luxtor_production_monitor_list" model="ir.ui.view">
        <field name="name">luxtor.production.monitor.list</field>
        <field name="model">luxtor.production.monitor</field>
        <field name="arch" type="xml">
            <list string="Production Monitor" default_order="date desc, id desc">
                <field name="date"/>
                <field name="name"/>
            </list>
        </field>
    </record>

    <!-- Monitor form -->
<!-- Luxtor Production Monitor form -->
        <record id="view_luxtor_production_monitor_form" model="ir.ui.view">
            <field name="name">luxtor.production.monitor.form</field>
            <field name="model">luxtor.production.monitor</field>
            <field name="arch" type="xml">
                <form string="Production Monitor">
                    <sheet>
                        <group col="2">
                            <group>
                                <field name="date" class="oe_inline"/>
                            </group>

                            <group class="o_group o_group_right" style="text-align:right;">
                                <button name="action_generate"
                                        type="object"
                                        string="Generate"
                                        class="btn btn-primary oe_highlight"/>
                            </group>
                        </group>
                    

                        <notebook>
                            <page string="Lines">
                                <field name="line_ids" options="{'no_open': True}">
                                    <list create="0" 
                                        delete="0"
                                        default_order="line_no desc, id desc">

                                        <field name="line_no" string="Line No."/>
                                        <field name="production_id"/>
                                        <field name="product_id" string="Product"/>
                                        <field name="width_m" string="Width"/>
                                        <field name="height_m" string="Height"/>
                                        <field name="roll_width" string="Roll Width"/>
                                        <field name="priority" string="Priority"/>
                                        <field name="state"
                                          string="Status"
                                          widget="badge"
                                          decoration-danger="state == 'not_started'"
                                          decoration-warning="state == 'in_works'"
                                          decoration-success="state == 'complete'"
                                          decoration-info="state == 'delivered'"/>

                                    <!-- Action icons (like your screenshot): doc/gear, box, print -->
                                    <button name="action_print_delivery_note" type="object"  icon="fa-cube" string="" class="btn-link"/>
                                    <button name="action_open_label" type="object" icon="fa-cogs" string="" class="btn-link"/>
                                    <button name="action_print_production_sheet" type="object" icon="fa-print" string="" class="btn-link"/>
                                        

                              
                                    
                                    </list>
                                </field>

                            </page>
                        </notebook>
                    </sheet>

                    
                </form>
            </field>
        </record>


    <!-- Extend Sale Order list -->
    <record id="view_order_form_lx_state_monitoring" model="ir.ui.view">
        <field name="name">sale.order.form.lx.state.monitoring</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">

        <xpath expr="//field[@name='order_line']//list//field[@name='price_total']" position="after">

        <field name="lx_state_monitoring"
          string="Status"
          widget="badge"
          decoration-danger="lx_state_monitoring == 'not_started'"
          decoration-warning="lx_state_monitoring == 'in_works'"
          decoration-success="lx_state_monitoring == 'complete'"
          decoration-info="lx_state_monitoring == 'delivered'"/>

        </xpath>
        <xpath expr="//field[@name='order_line']//list//field[@name='tax_ids']" position="attributes">
            <attribute name="invisible">1</attribute>
        </xpath>

        </field>
    </record>

    <!-- Action to browse monitor lines directly (optional) -->
    <record id="action_luxtor_production_monitor_lines" model="ir.actions.act_window">
        <field name="name">Production Monitor Lines</field>
        <field name="res_model">luxtor.production.monitor.line</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[]</field>
    </record>

    <record id="view_luxtor_production_monitor_line_list" model="ir.ui.view">
        <field name="name">luxtor.production.monitor.line.list</field>
        <field name="model">luxtor.production.monitor.line</field>
        <field name="arch" type="xml">
            <list string="Production Monitor Lines"
                  default_order="id desc"
                  decoration-danger="state == 'not_started'"
                  decoration-warning="state == 'in_works'"
                  decoration-success="state == 'complete'"
                  decoration-info="state == 'delivered'">

                <field name="sale_order_id" string="Sales Order"/>
                <field name="mo_ref" string="Manufacturing Order"/>
                <field name="product_id" string="Product"/>
                <field name="width_m" string="Width"/>
                <field name="height_m" string="Height"/>
                <field name="priority" string="Express"/>
                <field name="state" string="Status"/>
                <button name="action_print_delivery_note" type="object" icon="fa-cogs" string="" class="btn-link"/>
                <button name="action_open_label" type="object" icon="fa-cube" string="" class="btn-link"/>
                <button name="action_print_production_sheet" type="object" icon="fa-print" string="" class="btn-link"/>


            </list>
            


  
        </field>
    </record>

    <!-- Landscape paperformat close to your Excel sheet -->
    <record id="paperformat_lx_production_sheet" model="report.paperformat">
      <field name="name">Luxtor Production Sheet (A4 Portrait)</field>
      <field name="default" eval="False"/>
      <field name="format">A4</field>
      <field name="orientation">Portrait</field>
      <field name="margin_top">10</field>
      <field name="margin_bottom">10</field>
      <field name="margin_left">10</field>
      <field name="margin_right">10</field>
      <field name="header_line" eval="False"/>
      <field name="header_spacing">0</field>
      <field name="dpi">90</field>
    </record>

    <!-- Report action: prints from monitor line -->
    <record id="action_report_lx_production_sheet" model="ir.actions.report">
        <field name="name">Production Sheet</field>
        <field name="model">luxtor.production.monitor.line</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">luxtor_custom.report_lx_production_sheet</field>
        <field name="report_file">luxtor_custom.report_lx_production_sheet</field>
        <field name="paperformat_id" ref="luxtor_custom.paperformat_lx_production_sheet"/>
        <field name="print_report_name">'Production Sheet - %s' % (object.mo_ref or '')</field>
    </record>


   <!-- =========================================================
       MAIN REPORT (iterates docs) - INTERNAL LAYOUT (portrait)
       ========================================================= -->
  <template id="report_lx_production_sheet">
    <t t-call="web.html_container">
      <t t-foreach="docs" t-as="doc">
        <t t-set="o" t-value="doc"/>
        <t t-set="mo" t-value="(o and o._fields.get('production_id') and o.production_id) or False"/>
        <t t-set="company" t-value="(mo and mo.company_id and mo.company_id.sudo()) or o.env.company.sudo()"/>

        <t t-call="web.internal_layout">
          <t t-call="luxtor_custom.report_production_sheet_document"/>
        </t>
      </t>
    </t>
  </template>

 
<template id="report_luxtor_shipment_label">
    <t t-call="web.basic_layout">

        <style>
            /* CRITICAL: force wkhtmltopdf to respect label size */
            @page {
                size: 150mm 90mm;
                margin: 0 !important;
            }

            html, body {
                margin: 0 !important;
                padding: 0 !important;
            }

            /* Native label container */
            .page {
                width: 150mm;
                height: 90mm;
                overflow: hidden;   /* prevents 1px overflow blank page */
            }

            table {
                border-collapse: collapse;
                table-layout: fixed;
                width: 100%;
                height: 100%;
                font-family: Arial;
            }
        </style>

        <t t-foreach="docs" t-as="doc">
            <t t-set="v" t-value="values_by_id.get(doc.id) or {}"/>

            <div class="page">

                <table>
                    <tr style="height:40%;">
                        <td style="width:35%;border:2px solid #000;text-align:center;vertical-align:middle;">
                            <div style="font-size:28px;font-weight:800;">
                                LUXTOR
                            </div>
                        </td>

                        <td style="width:65%;border:2px solid #000;padding:6px;vertical-align:top;">
                            <div style="display:flex;justify-content:space-between;font-size:12px;">
                                <div>
                                    <strong>Date :</strong>
                                    <span t-esc="v.get('date_str')"/>
                                </div>

                                <div>
                                    <strong>Package :</strong>
                                    <span t-esc="v.get('package_ratio')"/>
                                </div>
                            </div>

                            <div style="margin-top:6px;font-size:12px;">
                                <strong>Package Details :</strong>
                            </div>

                            <div style="font-size:12px;white-space:pre-line;">
                                <span t-esc="v.get('package_details')"/>
                            </div>
                        </td>
                    </tr>

                    <tr style="height:60%;">
                        <td style="border:2px solid #000;padding:6px;vertical-align:top;font-size:12px;">

                            <div><strong>To :</strong></div>

                            <div>
                                <strong>Name :</strong>
                                <span t-esc="v.get('to_name')"/>
                            </div>

                            <div>
                                <strong>Address :</strong>
                                <span t-esc="v.get('to_address')"/>
                            </div>

                            <div>
                                <strong>City :</strong>
                                <span t-esc="v.get('to_city')"/>
                            </div>

                            <div>
                                <strong>Postal Code :</strong>
                                <span t-esc="v.get('to_zip')"/>
                            </div>

                            <div>
                                <strong>Phone :</strong>
                                <span t-esc="v.get('to_phone')"/>
                            </div>

                        </td>

                        <td style="border:2px solid #000;padding:6px;text-align:center;vertical-align:middle;">

                            <div style="font-size:12px;">
                                <strong>Weight</strong>
                            </div>

                            <!-- SMART DISPLAY -->
                            <div style="margin-top:10px;font-size:20px;font-weight:800;">

                                <t t-set="w" t-value="float(v.get('weight_kg') or 0.0)"/>

                                <span t-esc="'NC' if w &lt;= 0 else ('%.2f KG' % w)"/>

                            </div>

                        </td>
                    </tr>
                </table>

            </div>
        </t>

    </t>
</template>



<!-- =========================
     PAPERFORMAT (NO EXTRA HEADER SPACE)
     ========================= -->
<record id="paperformat_lx_shipment_label" model="report.paperformat">
  <field name="name">Luxtor Shipment Label 150x90</field>
  <field name="default" eval="False"/>
  <field name="format">custom</field>
  <field name="page_width">150</field>
  <field name="page_height">90</field>
  <field name="orientation">Landscape</field>

  <field name="margin_top">0</field>
  <field name="margin_bottom">0</field>
  <field name="margin_left">0</field>
  <field name="margin_right">0</field>

  <field name="header_line" eval="False"/>
  <!-- IMPORTANT: avoid blank extra page caused by header spacing -->
  <field name="header_spacing">0</field>

  <!-- IMPORTANT: keep exact label size; prevents smart scaling overflow -->
  <field name="disable_shrinking" eval="True"/>

  <field name="dpi">90</field>
</record>

  <record id="action_report_luxtor_shipment_label" model="ir.actions.report">
    <field name="name">Shipment Label</field>
    <field name="model">luxtor.production.monitor.line</field>
    <field name="report_type">qweb-pdf</field>
    <field name="report_name">luxtor_custom.report_luxtor_shipment_label</field>
    <field name="report_file">luxtor_custom.report_luxtor_shipment_label</field>

    <field name="binding_model_id" ref="luxtor_custom.model_luxtor_production_monitor_line"/>
    <field name="binding_type">report</field>

    <field name="paperformat_id" ref="luxtor_custom.paperformat_lx_shipment_label"/>
    <field name="print_report_name">'Label - %s' % (object.mo_ref or object.id)</field>
  </record>


