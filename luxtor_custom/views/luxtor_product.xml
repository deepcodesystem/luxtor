<odoo>

  <!-- Colors model -->
  <record id="view_lx_product_color_list" model="ir.ui.view">
    <field name="name">lx.product.color.list</field>
    <field name="model">lx.product.color</field>
    <field name="arch" type="xml">
      <list>
        <field name="sequence" widget="handle"/>
        <field name="name"/>
        <field name="color_hex"/>
      </list>
    </field>
  </record>

  <record id="view_lx_product_color_form" model="ir.ui.view">
    <field name="name">lx.product.color.form</field>
    <field name="model">lx.product.color</field>
    <field name="arch" type="xml">
      <form>
        <sheet>
          <group>
            <field name="name"/>
            <field name="sequence"/>
            <field name="color_hex"/>
          </group>
        </sheet>
      </form>
    </field>
  </record>

  <record id="action_lx_product_color" model="ir.actions.act_window">
    <field name="name">Shop Colors</field>
    <field name="res_model">lx.product.color</field>
    <field name="view_mode">list,form</field>
  </record>

<record id="view_product_template_form_luxtor_data_debug" model="ir.ui.view">
    <field name="name">product.template.form.luxtor.data</field>
    <field name="model">product.template</field>
    <field name="inherit_id" ref="product.product_template_only_form_view"/>
    <field name="arch" type="xml">

        <button name="action_open_documents" position="before">
            <button name="action_fetch_prices_from_boms"
                    type="object"
                    string="Fetch Price (BoMs)"
                    class="oe_stat_button"
                    icon="fa-money"/>
        </button>

        <xpath expr="//sheet/notebook" position="inside">
<page string="Data" name="luxtor_data">

    <group col="2">

        <!-- LEFT -->
        <group string="COMPUTATION">

            <label for="waste_rate"/>
            <div class="o_row">
                <field name="waste_rate" nolabel="1" class="oe_inline"/>
                <span class="ms-2">%</span>
            </div>

            <label for="added_margin"/>
            <div class="o_row">
                <field name="added_margin" nolabel="1" class="oe_inline"/>
                <span class="ms-2">%</span>
            </div>

            <label for="fabric_allowance"/>
            <div class="o_row">
                <field name="fabric_allowance" nolabel="1" class="oe_inline"/>
                <span class="ms-2">cm</span>
            </div>

            <label for="remenant_threshold"/>
            <div class="o_row">
                <field name="remenant_threshold" nolabel="1" class="oe_inline" string="Remnant Purge"/>
                <span class="ms-2">cm</span>
            </div>

            <label for="remenant_tolerence"/>
            <div class="o_row">
                <field name="remenant_tolerence" nolabel="1" class="oe_inline" string="Remnant Tolerance" />
                <span class="ms-2">%</span>
            </div>

        </group>

        <!-- RIGHT -->
        <group string="TECHNICAL">

            <label for="roller_width_ids"/>
            <div class="o_row">
                <field name="roller_width_ids" nolabel="1" widget="many2many_tags" class="oe_inline"/>
                <span class="ms-2">cm</span>
            </div>

            <label for="maximum_load"/>
            <div class="o_row">
                <field name="maximum_load" nolabel="1" class="oe_inline"/>
                <span class="ms-2">kg</span>
            </div>

            <label for="openness_factor_id"/>
            <div class="o_row">
                <field name="openness_factor_id" nolabel="1" class="oe_inline"/>
                <span class="ms-2">%</span>
            </div>

            <label for="color_fastness_id"/>
            <div class="o_row">
                <field name="color_fastness_id" nolabel="1" class="oe_inline"/>
                <span class="ms-2">grade</span>
            </div>

            <label for="lx_fabric_ref_id"/>
            <div class="o_row">
                <field name="lx_fabric_ref_id" nolabel="1" options="{'no_create_edit': False}"/>
            </div>

            <label for="lx_weight"/>
            <div class="o_row">
                <field name="lx_weight" nolabel="1" class="oe_inline"/>
                <span class="ms-2">g/m²</span>
            </div>

        </group>

    </group>

    <group col="2">

        <!-- LEFT -->
        <group string="TAGS">

            <label for="lx_is_sale"/>
            <div class="o_row">
                <field name="lx_is_sale" nolabel="1" widget="boolean_toggle"/>
            </div>

            <label for="lx_is_new_in"/>
            <div class="o_row">
                <field name="lx_is_new_in" nolabel="1" widget="boolean_toggle"/>
            </div>

            <label for="lx_is_weekly_deal"/>
            <div class="o_row">
                <field name="lx_is_weekly_deal" nolabel="1" widget="boolean_toggle"/>
            </div>

            <label for="lx_is_bestseller"/>
            <div class="o_row">
                <field name="lx_is_bestseller" nolabel="1" widget="boolean_toggle"/>
            </div>

            <label for="lx_is_trending"/>
            <div class="o_row">
                <field name="lx_is_trending" nolabel="1" widget="boolean_toggle"/>
            </div>

            <label for="lx_installation_space_id"/>
            <div class="o_row">
                <field name="lx_installation_space_id" nolabel="1"/>
            </div>

            <label for="lx_color_ids"/>
            <div class="o_row">
                <field name="lx_color_ids" nolabel="1" widget="many2many_tags"/>
            </div>



        </group>

        <!-- RIGHT -->
        <group string="MISC">

            <label for="uom_id"/>
            <div class="o_row">
                <field name="uom_id" nolabel="1"/>
            </div>

            <label for="lx_status"/>
            <div class="o_row">
                <field name="lx_status" nolabel="1" widget="radio" options="{'horizontal': true}"/>
            </div>

            <label for="orientation"/>
            <div class="o_row">
                <field name="orientation" nolabel="1" widget="radio" options="{'horizontal': true}"/>
            </div>

 

            <label for="model"/>
            <div class="o_row">
                <field name="model" nolabel="1"/>
            </div>

        </group>

    </group>

</page>

<page string="Luxtor Config" name="luxtor_config">
    <group string="Config DATA">

        <label for="max_height"/>
        <div class="o_row">
            <field name="max_height" nolabel="1" readonly="1" class="oe_inline"/>
            <span class="ms-2">m</span>
        </div>

        <label for="is_dimension_product"/>
        <div class="o_row">
            <field name="is_dimension_product" nolabel="1"/>
        </div>

        <label for="lx_qty_by_width"/>
        <div class="o_row">
            <field name="lx_qty_by_width" nolabel="1" string="Quantity Controlled by Width"/>
        </div>

        <label for="lx_qty_by_height"/>
        <div class="o_row">
            <field name="lx_qty_by_height" nolabel="1" string="Quantity Controlled by Height"/>
        </div>

        <label for="width_cm"/>
        <div class="o_row">
            <field name="width_cm" nolabel="1" readonly="1" class="oe_inline"/>
            <span class="ms-2">cm</span>
        </div>



    </group>
      <group string="Computed Data">

            <label for="is_mounting_bracket"/>
            <div class="o_row">
                <field name="is_mounting_bracket" nolabel="1"/>
            </div>
            <label for="lx_is_day_night"/>
            <div class="o_row">
                <field name="lx_is_day_night" nolabel="1"/>
            </div>
            <label for="lx_is_fabric"/>
            <div class="o_row">
                <field name="lx_is_fabric" nolabel="1"/>
            </div>

            <label for="lx_is_cassette"/>
            <div class="o_row">
                <field name="lx_is_cassette" nolabel="1"/>
            </div>

            <label for="lx_is_roller_tube"/>
            <div class="o_row">
                <field name="lx_is_roller_tube" nolabel="1"/>
            </div>

            <label for="lx_is_bottom_rail"/>
            <div class="o_row">
                <field name="lx_is_bottom_rail" nolabel="1"/>
            </div>

            <label for="lx_is_inner_tube"/>
            <div class="o_row">
                <field name="lx_is_inner_tube" nolabel="1"/>
            </div>

            <label for="lx_is_roller_mechanism"/>
            <div class="o_row">
                <field name="lx_is_roller_mechanism" nolabel="1"/>
            </div>

            <label for="lx_is_plastic_chain"/>
            <div class="o_row">
                <field name="lx_is_plastic_chain" nolabel="1"/>
            </div>
              </group>

</page>

<page string="Electric Config" name="lx_electric_config">
    <group string="Electric Accessory Type">
        <group>
            <field name="lx_is_tubular_motor"/>
            <field name="lx_is_remote_control"/>
            <field name="lx_is_zigbee_gateway"/>
        </group>
        <group>
            <field name="lx_is_electric_charger"/>
            <field name="lx_is_solar_charger"/>
            <field name="lx_is_idler"/>
        </group>
    </group>

    <!-- Idler mapping per motor variant — shown only for tubular motor templates -->
    <group string="Motor → Idler Mapping"
           invisible="not lx_is_tubular_motor">
        <field name="product_variant_ids" nolabel="1">
            <list editable="bottom">
                <field name="display_name" string="Motor Variant" readonly="1"/>
                <field name="lx_idler_variant_id"
                       string="Idler Variant"
                       domain="[('product_tmpl_id.lx_is_idler', '=', True)]"
                       options="{'no_create': True}"/>
            </list>
        </field>
    </group>
</page>


        </xpath>
    </field>
</record>

  <record id="view_product_template_uom_domain" model="ir.ui.view">
    <field name="name">product.template.uom.domain</field>
    <field name="model">product.template</field>
    <field name="inherit_id" ref="product.product_template_only_form_view"/>
    <field name="arch" type="xml">

      <xpath expr="//field[@name='uom_id']" position="attributes">
        <attribute name="domain">[("name","in",("m²","m","Unit","Set","Pair"))]</attribute>
      </xpath>



    </field>
  </record>

  <record id="view_product_product_uom_domain" model="ir.ui.view">
    <field name="name">product.product.uom.domain</field>
    <field name="model">product.product</field>
    <field name="inherit_id" ref="product.product_normal_form_view"/>
    <field name="arch" type="xml">

      <xpath expr="//field[@name='uom_id']" position="attributes">
        <attribute name="domain">[("name","in",("m²","m","Unit","Set","Pair"))]</attribute>
      </xpath>


    </field>
  </record>

  <record id="view_purchase_order_line_uom_domain" model="ir.ui.view">
    <field name="name">purchase.order.line.uom.strict.domain</field>
    <field name="model">purchase.order</field>
    <field name="inherit_id" ref="purchase.purchase_order_form"/>
    <field name="arch" type="xml">

      <xpath expr="//field[@name='order_line']/list//field[@name='product_uom_id']" position="attributes">
        <attribute name="domain">[('name','in',('m²','m','Unit','Set','Pair'))]</attribute>
      </xpath>

      <xpath expr="//field[@name='order_line']/form//field[@name='product_uom_id']" position="attributes">
        <attribute name="domain">[('name','in',('m²','m','Unit','Set','Pair'))]</attribute>
      </xpath>
    </field>
  </record>

  <record id="view_mrp_production_uom_strict_domain" model="ir.ui.view">
    <field name="name">mrp.production.uom.strict.domain</field>
    <field name="model">mrp.production</field>
    <field name="inherit_id" ref="mrp.mrp_production_form_view"/>
    <field name="arch" type="xml">

      <xpath expr="//page[@name='components']/field[@name='move_raw_ids']/list/field[@name='product_uom']"
             position="attributes">
        <attribute name="domain">[('name','in',('m²','m','Unit','Set','Pair'))]</attribute>
      </xpath>

    </field>
  </record>

  <record id="view_mrp_bom_uom_strict_domain" model="ir.ui.view">
    <field name="name">mrp.bom.uom.strict.domain</field>
    <field name="model">mrp.bom</field>
    <field name="inherit_id" ref="mrp.mrp_bom_form_view"/>
    <field name="arch" type="xml">

      <xpath expr="//page[@name='components']/field[@name='bom_line_ids']//list//field[@name='product_uom_id']"
             position="attributes">
        <attribute name="domain">[('name','in',('m²','m','Unit','Set','Pair'))]</attribute>
      </xpath>

    </field>
  </record>

         <!--
            Inherit the Odoo 19 PTAV list view.
            External ID confirmed from live instance (Image 1):
              product.product_template_attribute_value_view_tree
            Model: product.template.attribute.value
        -->
        <record id="lx_ptav_view_list" model="ir.ui.view">
            <field name="name">product.template.attribute.value.list.lx_motor_label</field>
            <field name="model">product.template.attribute.value</field>
            <field name="inherit_id" ref="product.product_template_attribute_value_view_tree"/>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='price_extra']" position="before">
                    <field name="lx_motor_label"
                           string="Motor Control Name"
                           optional="show"/>
                </xpath>
            </field>
        </record>
 
        <!--
            Inherit the Odoo 19 PTAV form view.
            External ID confirmed from live instance (Image 2):
              product.product_template_attribute_value_view_form
            Model: product.template.attribute.value
        -->
        <record id="lx_ptav_view_form" model="ir.ui.view">
            <field name="name">product.template.attribute.value.form.lx_motor_label</field>
            <field name="model">product.template.attribute.value</field>
            <field name="inherit_id" ref="product.product_template_attribute_value_view_form"/>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='name']" position="after">
                    <field name="lx_motor_label"
                           string="Motor Control Name"
                           placeholder="e.g. Remote Motor, Smart Motor…"
                           help="Friendly label shown in the Motor Control dialog. Leave empty to use the Code value."/>
                </xpath>
            </field>
        </record>



</odoo>
