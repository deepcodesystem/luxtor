<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <template id="lx_payment_page" inherit_id="website_sale.payment" name="Luxtor Payment Page">
    <xpath expr="//div[@id='payment_method']" position="replace">
      <div id="payment_method" class="o_not_editable mt-4 lx-payment-wrap">
        <t t-set="lx_payment_choice" t-value="(website_sale_order and website_sale_order.lx_payment_terms) or (lx_payment_choice or 'upfront')"/>
        <t t-set="lx_payment_summary" t-value="lx_payment_summary or (website_sale_order._lx_payment_summary_values() if website_sale_order else {})"/>

        <form id="lx_payment_form" action="/shop/payment/select" method="post" class="o_website_sale lx-payment-form">
          <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>

          <div class="lx-payment-group" role="radiogroup" aria-label="Payment method">
            <input type="radio" id="lx_payment_upfront" name="lx_payment_terms" value="upfront" class="lx-payment-radio" t-att-checked="'checked' if lx_payment_choice == 'upfront' else None"/>
            <label class="lx-payment-card" for="lx_payment_upfront">
              <span class="lx-payment-card-body">
                <span class="lx-payment-title">100% on Order</span>
                <span class="lx-payment-subtitle">Paiement par Carte Bancaire</span>
              </span>
            </label>

            <input type="radio" id="lx_payment_half_half" name="lx_payment_terms" value="half_half" class="lx-payment-radio" t-att-checked="'checked' if lx_payment_choice == 'half_half' else None"/>
            <label class="lx-payment-card" for="lx_payment_half_half">
              <span class="lx-payment-card-body">
                <span class="lx-payment-title">50% on Order &amp; 50% on Delivery</span>
                <span class="lx-payment-subtitle">Paiement par Carte Bancaire</span>
              </span>
            </label>
          </div>

          <div class="lx-payment-offer-wrap mt-4">
            <div class="lx-payment-offer-heading mb-2">Offer</div>
            <div class="lx-payment-offer-box">
              <div class="lx-payment-offer-line">
                <div class="lx-payment-offer-icon" aria-hidden="true">
                  <span class="lx-payment-offer-dot" aria-hidden="true"/>
                </div>
                <div class="lx-payment-offer-text">
                  <div class="lx-payment-offer-main">Fast, secure, and reliable.</div>
                  <div class="lx-payment-offer-sub">
                    Wire transfer offers transaction traceability and helps reduce fraud risk.
                  </div>
                </div>
              </div>
              <div class="lx-payment-offer-learn mt-2">
                <a href="#payment_method" class="lx-payment-offer-link">Learn more</a>
              </div>
            </div>
          </div>
        </form>
      </div>
    </xpath>
  </template>
</odoo>
