<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <record id="view_purchase_order_form_luxtor_custom" model="ir.ui.view">
    <field name="name">purchase.order.form.luxtor.custom</field>
    <field name="model">purchase.order</field>
    <field name="inherit_id" ref="purchase.purchase_order_form"/>
    <field name="arch" type="xml">

      <!-- Add LoT Number and Width after product_id and before product_qty -->
      <xpath expr="//field[@name='order_line']/form//field[@name='product_id']" position="after">
        <field name="lot_id" />
        <field name="width"/>
      </xpath>

      <!-- Also show LoT Number and Width in the tree view -->
      <xpath expr="//field[@name='order_line']/list//field[@name='product_id']" position="after">
        <field name="lot_id"/>
        <field name="width"/>
      </xpath>

    </field>
  </record>
</odoo>
