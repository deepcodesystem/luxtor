<?xml version="1.0" encoding="UTF-8"?>
<odoo>

  <template id="lx_homepage" name="Luxtor Homepage">
    <t t-call="website.layout">
      <t t-set="opt_wsale_design_grid" t-value="'o_wsale_products_opt_design_grid' in website.shop_opt_products_design_classes"/>
      <div id="wrap" t-attf-class="js_sale o_wsale_products_page {{opt_wsale_design_grid and 'o_wsale_uses_grid_design'}}">
        <style>
          .lx-home-featured-section .carousel-inner {
            overflow: visible;
          }
          .lx-home-featured-section .carousel-item {
            padding: 0.25rem 0;
          }
          .lx-home-featured-section .o_wsale_products_grid_table {
            --o-wsale-ppr: 4;
            --o-wsale-ppg: 4;
          }
          .lx-home-featured-section .lx-carousel-ctrl {
            width: auto;
            top: -4.5rem;
            bottom: auto;
            opacity: 1;
            color: var(--bs-dark);
          }
          .lx-home-featured-section .lx-carousel-ctrl.carousel-control-prev {
            right: 3rem;
            left: auto;
          }
          .lx-home-featured-section .lx-carousel-ctrl.carousel-control-next {
            right: 0;
          }
          @media (max-width: 767.98px) {
            .lx-home-featured-section .lx-carousel-ctrl {
              top: auto;
              bottom: -3.5rem;
            }
            .lx-home-featured-section .lx-carousel-ctrl.carousel-control-prev {
              right: 3.5rem;
            }
          }
        </style>

        <section class="lx-home-featured-section py-5 bg-white">
          <div t-attf-class="oe_website_sale container {{opt_wsale_design_grid and 'o_wsale_uses_grid_design'}}">
            <div class="d-flex justify-content-between align-items-baseline mb-4">
              <div>
                <h2 class="fw-bold mb-1">Nouveautes.</h2>
                <p class="text-muted mb-0 small">Soyez les premiers a les decouvrir !</p>
              </div>
              <a href="/shop?lx_interest=new_in" class="fw-semibold text-dark text-decoration-none">
                Voir tout <i class="fa fa-long-arrow-right ms-2"/>
              </a>
            </div>

            <t t-if="new_in_products">
              <div id="lx_new_in_carousel" class="carousel slide carousel-dark position-relative">
                <div class="carousel-inner">
                  <t t-foreach="new_in_slides" t-as="slide">
                    <div t-att-class="'carousel-item' + (' active' if slide_index == 0 else '')">
                      <section
                        id="lx_new_in_products_grid"
                        t-attf-class="o_wsale_products_grid_table grid {{website.shop_opt_products_design_classes}}"
                        t-attf-style="--o-wsale-products-grid-gap: {{gap}}; --o-wsale-ppr: {{ppr}}; --o-wsale-ppg: {{ppg}}"
                      >
                        <t t-foreach="slide" t-as="td_product">
                          <t t-if="td_product">
                            <t t-set="col_height" t-value="td_product['y']"/>
                            <t t-set="col_width" t-value="12 // ppr * td_product['x']"/>
                            <t t-set="col_class_lg" t-value="'g-col-lg-' + str(col_width)"/>
                            <t t-set="col_class_md" t-value="'g-col-md-4' if ppr == 4 else 'g-col-md-6'"/>
                            <t t-set="col_is_stretched" t-value="(td_product['x'] &gt;= td_product['y'] * 2)"/>
                            <t t-set="col_is_custom_portrait" t-value="not col_is_stretched and (col_height &gt; td_product['x'])"/>
                            <div
                              t-attf-class="oe_product {{col_is_custom_portrait and 'oe_product_custom_portrait'}} g-col-6 {{col_class_md}} {{col_class_lg}} {{col_is_stretched and 'oe_product_size_stretch'}}"
                              t-attf-style="--o-wsale-products-grid-product-col-height: {{col_height}};"
                              t-att-data-ribbon-id="td_product['ribbon'].id"
                              t-att-data-colspan="td_product['x'] != 1 and td_product['x']"
                              t-att-data-rowspan="td_product['y'] != 1 and td_product['y']"
                            >
                              <div t-attf-class="o_wsale_product_grid_wrapper position-relative h-100 o_wsale_product_grid_wrapper_#{td_product['x']}_#{td_product['y']}">
                                <t t-call="website_sale.products_item">
                                  <t t-set="product" t-value="td_product['product']"/>
                                  <t t-set="template_price_vals" t-value="get_product_prices(product)"/>
                                  <t t-set="ribbon" t-value="product._get_ribbon(price_vals=template_price_vals, auto_assign_ribbons=auto_assign_ribbons, variant=product_variants.get(product))"/>
                                  <t t-set="design_field" t-value="website.shop_opt_products_design_classes"/>
                                  <t t-set="product_href" t-value="product._get_product_url(False, product_query_params, grouped_attributes_values)"/>
                                </t>
                              </div>
                            </div>
                          </t>
                        </t>
                      </section>
                    </div>
                  </t>
                </div>

                <t t-if="len(new_in_slides) > 1">
                  <a class="carousel-control-prev lx-carousel-ctrl" href="#lx_new_in_carousel" role="button" data-bs-slide="prev" aria-label="Previous">
                    <span class="fa fa-chevron-circle-left fa-2x" aria-hidden="true"/>
                  </a>
                  <a class="carousel-control-next lx-carousel-ctrl" href="#lx_new_in_carousel" role="button" data-bs-slide="next" aria-label="Next">
                    <span class="fa fa-chevron-circle-right fa-2x" aria-hidden="true"/>
                  </a>
                </t>
              </div>
            </t>
            <t t-else="">
              <p class="text-muted fst-italic">Aucun produit a afficher pour le moment.</p>
            </t>
          </div>
        </section>

        <section class="lx-home-featured-section py-5" style="background:#f8f9fa;">
          <div t-attf-class="oe_website_sale container {{opt_wsale_design_grid and 'o_wsale_uses_grid_design'}}">
            <div class="d-flex justify-content-between align-items-baseline mb-4">
              <div>
                <h2 class="fw-bold mb-1">Offre de la semaine.</h2>
                <p class="text-muted mb-0 small">Economisez des maintenant !</p>
              </div>
              <a href="/shop?lx_interest=weekly_deal" class="fw-semibold text-dark text-decoration-none">
                Voir tout <i class="fa fa-long-arrow-right ms-2"/>
              </a>
            </div>

            <t t-if="weekly_products">
              <div id="lx_weekly_carousel" class="carousel slide carousel-dark position-relative">
                <div class="carousel-inner">
                  <t t-foreach="weekly_slides" t-as="slide">
                    <div t-att-class="'carousel-item' + (' active' if slide_index == 0 else '')">
                      <section
                        id="lx_weekly_products_grid"
                        t-attf-class="o_wsale_products_grid_table grid {{website.shop_opt_products_design_classes}}"
                        t-attf-style="--o-wsale-products-grid-gap: {{gap}}; --o-wsale-ppr: {{ppr}}; --o-wsale-ppg: {{ppg}}"
                      >
                        <t t-foreach="slide" t-as="td_product">
                          <t t-if="td_product">
                            <t t-set="col_height" t-value="td_product['y']"/>
                            <t t-set="col_width" t-value="12 // ppr * td_product['x']"/>
                            <t t-set="col_class_lg" t-value="'g-col-lg-' + str(col_width)"/>
                            <t t-set="col_class_md" t-value="'g-col-md-4' if ppr == 4 else 'g-col-md-6'"/>
                            <t t-set="col_is_stretched" t-value="(td_product['x'] &gt;= td_product['y'] * 2)"/>
                            <t t-set="col_is_custom_portrait" t-value="not col_is_stretched and (col_height &gt; td_product['x'])"/>
                            <div
                              t-attf-class="oe_product {{col_is_custom_portrait and 'oe_product_custom_portrait'}} g-col-6 {{col_class_md}} {{col_class_lg}} {{col_is_stretched and 'oe_product_size_stretch'}}"
                              t-attf-style="--o-wsale-products-grid-product-col-height: {{col_height}};"
                              t-att-data-ribbon-id="td_product['ribbon'].id"
                              t-att-data-colspan="td_product['x'] != 1 and td_product['x']"
                              t-att-data-rowspan="td_product['y'] != 1 and td_product['y']"
                            >
                              <div t-attf-class="o_wsale_product_grid_wrapper position-relative h-100 o_wsale_product_grid_wrapper_#{td_product['x']}_#{td_product['y']}">
                                <t t-call="website_sale.products_item">
                                  <t t-set="product" t-value="td_product['product']"/>
                                  <t t-set="template_price_vals" t-value="get_product_prices(product)"/>
                                  <t t-set="ribbon" t-value="product._get_ribbon(price_vals=template_price_vals, auto_assign_ribbons=auto_assign_ribbons, variant=product_variants.get(product))"/>
                                  <t t-set="design_field" t-value="website.shop_opt_products_design_classes"/>
                                  <t t-set="product_href" t-value="product._get_product_url(False, product_query_params, grouped_attributes_values)"/>
                                </t>
                              </div>
                            </div>
                          </t>
                        </t>
                      </section>
                    </div>
                  </t>
                </div>

                <t t-if="len(weekly_slides) > 1">
                  <a class="carousel-control-prev lx-carousel-ctrl" href="#lx_weekly_carousel" role="button" data-bs-slide="prev" aria-label="Previous">
                    <span class="fa fa-chevron-circle-left fa-2x" aria-hidden="true"/>
                  </a>
                  <a class="carousel-control-next lx-carousel-ctrl" href="#lx_weekly_carousel" role="button" data-bs-slide="next" aria-label="Next">
                    <span class="fa fa-chevron-circle-right fa-2x" aria-hidden="true"/>
                  </a>
                </t>
              </div>
            </t>
            <t t-else="">
              <p class="text-muted fst-italic">Aucune offre cette semaine.</p>
            </t>
          </div>
        </section>
      </div>
    </t>
  </template>

</odoo>
