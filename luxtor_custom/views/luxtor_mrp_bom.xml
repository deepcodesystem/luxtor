<odoo>
  <record id="view_mrp_bom_form_luxtor_custom" model="ir.ui.view">
    <field name="name">mrp.bom.form.luxtor.custom</field>
    <field name="model">mrp.bom</field>
    <field name="inherit_id" ref="mrp.mrp_bom_form_view"/>
    <field name="arch" type="xml">
      <xpath expr="//field[@name='bom_line_ids']" position="attributes">
          <attribute name="limit">500</attribute>
        </xpath>

      <xpath expr="//form[1]/sheet[1]/group[1]/group[1]/div[1]" position="after">
        <div>
            <div class="o_row">
                        <label for="width_mrp"/>

                <field name="width_mrp" class="oe_inline"/>
                <span style="margin-left:4px;">m</span>
            </div>

            <div class="o_row">
                        <label for="height_mrp"/>

                <field name="height_mrp" class="oe_inline"/>
                <span style="margin-left:4px;">m</span>
            </div>
        </div>
      </xpath>


