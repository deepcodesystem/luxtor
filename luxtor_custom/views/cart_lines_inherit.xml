<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <data>

    <template id="lx_cart_lines_inherit" inherit_id="website_sale.cart_lines" name="Luxtor Cart Lines">

      <!-- ── 0. Filter child accessory lines from the top-level loop ──────────── -->
      <!--    Child lines (motor, remote…) have lx_parent_line_id set.             -->
      <!--    Without this they render as top-level o_cart_product rows AND as     -->
      <!--    a child block (XPath #4) → duplication.  Setting t-if here prevents  -->
      <!--    top-level rendering.  Uses hasclass() — same confirmed-working        -->
      <!--    pattern as XPath #1 below.                                            -->
      <xpath expr="//div[hasclass('o_cart_product')]" position="attributes">
        <attribute name="t-if">(line.product_template_id.type in ('consu', 'combo')) and ('% on your order' not in (line.name or '')) and not line.lx_parent_line_id</attribute>
      </xpath>

      <!-- ── 1. Add data-default-code and data-is-dim on the parent product row ── -->
      <!--    hasclass() checks the literal class attribute. We exclude rows that   -->
      <!--    already carry lx_accessory_line so the attribute is not applied to   -->
      <!--    child accessory divs (where `line` would be the wrong variable).      -->
      <xpath expr="//div[hasclass('o_cart_product')]" position="attributes">
        <attribute name="t-att-data-default-code">(line.product_id.default_code or '').upper()</attribute>
        <attribute name="t-att-data-is-dim">1 if (line.product_template_id and line.product_template_id.is_dimension_product) else 0</attribute>
        <attribute name="t-att-data-lx-line-id">line.id</attribute>
      </xpath>

      <!-- ── 2. Force qty +/- buttons always visible (bypasses is_view_active) ── -->
      <!--    The native V19 template uses <t t-foreach> so this matches;          -->
      <!--    if the DB template uses <div t-foreach> this xpath silently skips.   -->
      <xpath expr="//t[@t-foreach='website_sale_order.website_order_line']" position="before">
        <t t-set="show_qty" t-value="True"/>
      </xpath>

      <!-- ── 3. Dimension subtitle — after the variants description line ───────── -->
      <xpath expr="//t[@t-call='website_sale.cart_line_description_following_lines']" position="after">
        <t t-if="line.product_template_id and line.product_template_id.is_dimension_product">
          <div class="lx-dims-line fw-semibold mt-1">
            [<t t-esc="'%.2f' % (line.lx_width_m or 0)"/> m &#215;
             <t t-esc="'%.2f' % (line.lx_height_m or 0)"/> m]
          </div>
        </t>
      </xpath>

      <!-- ── 4. Accessory child rows — rendered under each parent product row ──── -->
      <!--                                                                          -->
      <!--    Injected AFTER every div.o_cart_product inside #cart_products.       -->
      <!--    After website_sale_cart_lines.xml filters child lines from the main  -->
      <!--    loop, only parent divs carry o_cart_product, so this fires once per  -->
      <!--    parent and never for child lines → no duplication.                   -->
      <!--                                                                          -->
      <!--    Design: native Odoo font/spacing, left spacer column aligned with    -->
      <!--    the parent's thumbnail area, thin border-top to separate from the    -->
      <!--    parent's content, border-bottom between consecutive child rows.       -->
      <xpath expr="//div[@id='cart_products']//div[hasclass('o_cart_product')]" position="after">

        <t t-set="lx_children" t-value="website_sale_order.order_line.filtered(
            lambda l: l.lx_parent_line_id and l.lx_parent_line_id.id == line.id
            and not l.display_type
        ).sorted(lambda l: (l.sequence or 0, l.id))"/>

        <t t-if="lx_children">
          <!--
            Accessory child block.
            CSS (.o_cart_product:has(+ .lx-acc-block)) suppresses the parent's
            native border-bottom/pb-4; this block ends with its own bottom border
            to cleanly close the group before the next parent row.
          -->
          <div class="lx-acc-block" t-att-data-lx-parent-id="line.id">
            <t t-foreach="lx_children" t-as="acc">
              <div t-if="acc.product_id and not acc.display_type"
                   class="lx_accessory_line d-flex align-items-center gap-3 py-2"
                   t-att-data-lx-acc-line-id="acc.id"
                   t-att-data-lx-sequence="acc.sequence or 0"
                   t-attf-data-product-id="#{acc.product_id.id}"
                   t-att-data-lx-tip="'REMOTE' if acc.product_id.product_tmpl_id.lx_is_remote_control else ('ZIGBEE' if acc.product_id.product_tmpl_id.lx_is_zigbee_gateway else ('CHARGER' if (acc.product_id.product_tmpl_id.lx_is_electric_charger or acc.product_id.product_tmpl_id.lx_is_solar_charger) else False))">

                <!-- Thumbnail — fixed slot, fallback icon when no image -->
                <div class="lx-acc-thumb">
                  <img t-if="acc.product_id.image_128"
                       t-att-src="image_data_uri(acc.product_id.image_128)"
                       t-att-alt="acc.name_short"/>
                  <div t-else="" class="lx-acc-no-img">
                    <i class="fa fa-cube"/>
                  </div>
                </div>

                <!-- Name + Remove -->
                <div class="flex-grow-1 min-w-0">
                  <div class="fw-normal lh-sm">
                    <t t-esc="acc.name_short"/>
                  </div>
                  <div name="o_wsale_cart_line_button_container">
                    <a href="#"
                       class="js_delete_product d-none d-md-inline-block small"
                       aria-label="Remove from cart"
                       title="Remove from cart">Remove</a>
                    <button class="js_delete_product btn btn-light btn-sm d-inline-block d-md-none"
                            title="remove">
                      <i class="fa fa-trash-o"/>
                    </button>
                  </div>
                </div>

                <!-- Plain qty number + price — right column -->
                <div class="d-flex flex-column align-items-end gap-1">
                  <span class="lx-acc-qty-label text-muted small">
                    <t t-esc="int(acc.product_uom_qty or 0)"/>
                  </span>
                  <div class="lx-acc-price text-end">
                    <t t-set="product_price" t-value="acc._get_cart_display_price()"/>
                    <t t-call="website_sale.cart_product_price">
                      <t t-set="line" t-value="acc"/>
                    </t>
                  </div>
                </div>

              </div>
            </t>
          </div>
        </t>

      </xpath>

    </template>
  </data>
</odoo>
