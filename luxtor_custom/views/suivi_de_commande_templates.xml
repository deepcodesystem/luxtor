<?xml version="1.0" encoding="utf-8"?>
<odoo>

  <template id="suivi_de_commande_page_qweb" name="Suivi de commande">
    <t t-call="website.layout">
      <div id="wrap" class="oe_structure">
        <div class="container py-5">
          <h1 class="text-center mb-5">Suivi de commande</h1>

          <!-- Aucune commande -->
          <t t-if="not has_available_order">
            <div class="alert alert-info">
              <p class="mb-1">Aucune commande confirmée n'est disponible pour le suivi.</p>
              <t t-if="request.env.user._is_public()">
                <p class="mb-0">Pour un suivi détaillé,
                  <a href="/web/login">connectez-vous à votre compte</a>.
                </p>
              </t>
            </div>
          </t>

          <!-- Commande disponible -->
          <t t-if="has_available_order">

            <!-- Étape 1 — Confirmation -->
            <section class="lx-tracking-step mb-4 p-4 rounded-3 shadow-sm" style="background:#f8f9fa;">
              <div class="d-flex align-items-center gap-3 mb-3">
                <span class="lx-step-badge bg-success text-white rounded-circle d-flex align-items-center justify-content-center" style="width:36px;height:36px;font-weight:700;">1</span>
                <h5 class="mb-0">Confirmation de commande</h5>
              </div>
              <p>
                Bonjour <strong><t t-esc="contact_name or 'Client'"/></strong>,<br/>
                Merci pour votre commande ! Vos stores enroulables sur-mesure sont en préparation.
              </p>
              <ul class="list-unstyled mb-0">
                <t t-if="order_name">
                  <li><i class="fa fa-hashtag me-2 text-muted"/>Commande n° : <strong><t t-esc="order_name"/></strong></li>
                </t>
                <t t-if="estimate">
                  <li><i class="fa fa-calendar me-2 text-muted"/>Livraison estimée : <strong><t t-esc="estimate"/></strong></li>
                </t>
              </ul>
            </section>

            <!-- Étape 2 — Production -->
            <t t-if="order_in_production">
              <section class="lx-tracking-step mb-4 p-4 rounded-3 shadow-sm" style="background:#f8f9fa;">
                <div class="d-flex align-items-center gap-3 mb-3">
                  <span class="lx-step-badge bg-primary text-white rounded-circle d-flex align-items-center justify-content-center" style="width:36px;height:36px;font-weight:700;">2</span>
                  <h5 class="mb-0">Production en cours</h5>
                </div>
                <p>
                  Bonne nouvelle ! La fabrication de vos stores a commencé.
                  Notre équipe s'assure qu'ils correspondent parfaitement à vos spécifications.
                </p>
                <ul class="list-unstyled mb-0">
                  <t t-if="order_name">
                    <li><i class="fa fa-hashtag me-2 text-muted"/>Commande n° : <strong><t t-esc="order_name"/></strong></li>
                  </t>
                  <t t-if="estimate">
                    <li><i class="fa fa-calendar me-2 text-muted"/>Livraison estimée : <strong><t t-esc="estimate"/></strong></li>
                  </t>
                </ul>
              </section>
            </t>

            <!-- Étape 3 — Expédition -->
            <t t-if="show_shipping">
              <section class="lx-tracking-step mb-4 p-4 rounded-3 shadow-sm" style="background:#f8f9fa;">
                <div class="d-flex align-items-center gap-3 mb-3">
                  <span class="lx-step-badge bg-warning text-dark rounded-circle d-flex align-items-center justify-content-center" style="width:36px;height:36px;font-weight:700;">3</span>
                  <h5 class="mb-0">Commande expédiée</h5>
                </div>
                <p>
                  Vos stores enroulables
                  <t t-if="carrier_name">ont été expédiés avec <strong><t t-esc="carrier_name"/></strong></t>
                  <t t-if="not carrier_name">sont en cours d'expédition</t>
                  et sont en chemin pour vous parvenir.
                </p>
                <ul class="list-unstyled mb-0">
                  <t t-if="carrier_name">
                    <li><i class="fa fa-truck me-2 text-muted"/>Transporteur : <strong><t t-esc="carrier_name"/></strong></li>
                  </t>
                  <t t-if="tracking">
                    <li><i class="fa fa-barcode me-2 text-muted"/>Numéro de suivi : <strong><t t-esc="tracking"/></strong></li>
                  </t>
                  <t t-if="estimate">
                    <li><i class="fa fa-calendar me-2 text-muted"/>Livraison estimée : <strong><t t-esc="estimate"/></strong></li>
                  </t>
                </ul>
              </section>
            </t>

            <div class="text-center mt-4">
              <a href="/" class="btn btn-outline-secondary">
                <i class="fa fa-home me-1"/>Retour à l'accueil
              </a>
            </div>

          </t>
        </div>
      </div>
    </t>
  </template>

</odoo>
