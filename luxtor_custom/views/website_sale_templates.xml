<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <template id="luxtor_product_dims_and_express" inherit_id="website_sale.product">

    <!--
      ══════════════════════════════════════════════════════
      1. Dimension inputs (Width / Height) — before variants
         Works in both V18 and V19 since both call
         website_sale.variants from the product form.
      ══════════════════════════════════════════════════════
    -->
    <xpath expr="//t[@t-call='website_sale.variants']" position="before">
      <t t-if="product.bom_ids">
        <t t-set="lx_locations" t-value="request.env['luxtor.installation.space'].sudo().search([], order='name asc')"/>
        <t t-set="lx_other_location" t-value="request.env['luxtor.installation.space'].sudo().search([('name', '=', 'Other')], limit=1)"/>
        <t t-set="lx_session_location_id" t-value="int((request.session.get('lx_dims') or {}).get('lx_location_id') or 0) if request and request.session else 0"/>
        <t t-set="lx_default_location_id" t-value="lx_session_location_id or (lx_other_location.id if lx_other_location else (lx_locations[:1].id if lx_locations else 0))"/>
        <div id="lx_dims_express" class="mt-3">

          <!-- LOCATION -->
          <div class="lx-dim-field">
            <h6 class="attribute_name mb-2 lx-dim-heading"
                style="display:block !important;text-transform:uppercase !important;font-size:0.82rem !important;font-weight:700 !important;letter-spacing:0.05em !important;color:#6b7280 !important;margin:0 0 0.5rem 0 !important;line-height:1.2 !important;padding:0 !important;border:0 !important;background:transparent !important;font-style:normal !important;font-family:'Poppins', 'Odoo Unicode Support Noto', sans-serif !important;text-align:left !important;box-shadow:none !important;">
              <span>LOCATION</span><span class="notificationmessage" data-tooltip="Enter your room"> ?</span>
            </h6>
            <label for="lx_location_input" class="visually-hidden">Location</label>
            <select id="lx_location_input"
                    name="lx_location_id"
                    class="form-select js-lx-location lx-dim-input"
                    t-att-data-lx-location-loaded="'1' if lx_locations else '0'">
              <t t-if="lx_locations">
                <t t-foreach="lx_locations" t-as="lx_location">
                  <option t-att-value="lx_location.id"
                          t-att-selected="True if lx_location.id == lx_default_location_id else None">
                    <t t-esc="lx_location.name"/>
                  </option>
                </t>
              </t>
              <t t-else="">
                <option value="">Loading locations...</option>
              </t>
            </select>
          </div>

          <!-- WIDTH -->
          <div class="lx-dim-field">
            <h6 class="attribute_name mb-2 lx-dim-heading"
                style="display:block !important;text-transform:uppercase !important;font-size:0.82rem !important;font-weight:700 !important;letter-spacing:0.05em !important;color:#6b7280 !important;margin:0 0 0.5rem 0 !important;line-height:1.2 !important;padding:0 !important;border:0 !important;background:transparent !important;font-style:normal !important;font-family:'Poppins', 'Odoo Unicode Support Noto', sans-serif !important;text-align:left !important;box-shadow:none !important;">
              <span>WIDTH</span><span class="notificationmessage" data-tooltip="Enter the width of your window"> ?</span>
            </h6>
            <label for="lx_width_input" class="visually-hidden">Width</label>
            <input id="lx_width_input" type="number" step="0.01" min="0"
                   class="form-control js-lx-width lx-dim-input" name="lx_width_m"
                   placeholder="min: 0.60 m / max: 3.00 m" inputmode="decimal"/>
            <span id="lx_width_hint" class="form-text text-muted small js-lx-width-hint d-none"/>
          </div>

          <!-- HEIGHT -->
          <div class="lx-dim-field">
            <h6 class="attribute_name mb-2 lx-dim-heading"
                style="display:block !important;text-transform:uppercase !important;font-size:0.82rem !important;font-weight:700 !important;letter-spacing:0.05em !important;color:#6b7280 !important;margin:0 0 0.5rem 0 !important;line-height:1.2 !important;padding:0 !important;border:0 !important;background:transparent !important;font-style:normal !important;font-family:'Poppins', 'Odoo Unicode Support Noto', sans-serif !important;text-align:left !important;box-shadow:none !important;">
              <span>HEIGHT</span><span class="notificationmessage" data-tooltip="Enter the height of your window"> ?</span>
            </h6>
            <label for="lx_height_input" class="visually-hidden">Height</label>
            <input id="lx_height_input" type="number" step="0.01" min="0"
                   class="form-control js-lx-height lx-dim-input" name="lx_height_m"
                   placeholder="min: 0.90 m / max: 5.62 m" inputmode="decimal"/>
            <span id="lx_height_hint" class="form-text text-muted small js-lx-height-hint d-none"/>
          </div>

        </div>
      </t>
    </xpath>

    <!--
      ══════════════════════════════════════════════════════
      2. "From" label before the price — V19 price section
         The V19 template wraps the price call inside a div
         with class o_wsale_product_details_content_section_price.
         We replace it with our custom wrapper.
      ══════════════════════════════════════════════════════
    -->
    <xpath expr="//div[contains(@class,'o_wsale_product_details_content_section_price')]"
           position="replace">
      <div class="o_wsale_product_details_content_section o_wsale_product_details_content_section_price mb-4">
        <t t-set="has_bom" t-value="bool(product.sudo().bom_ids)"/>
        <div class="lx-price-row d-flex align-items-baseline gap-2">
          <t t-if="has_bom">
            <span class="lx_from_label"
                  style="font-weight:700;font-size:1.75rem;line-height:1.2;
                         color:#3b82f6;margin-top:6px;">From</span>
          </t>
          <t t-call="website_sale.product_price"/>
        </div>
        <small t-if="combination_info.get('base_unit_price')"
               class="ms-1 text-muted o_base_unit_price_wrapper d-none">
          <t t-call="website_sale.base_unit_price">
            <t t-set="base_unit_price" t-value="combination_info['base_unit_price']"/>
          </t>
        </small>
      </div>
    </xpath>

  </template>
</odoo>
