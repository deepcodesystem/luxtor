<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <template id="lx_delivery_form_heading" inherit_id="website_sale.delivery_form" name="Luxtor Delivery Form Heading">
    <xpath expr="//form[@id='o_delivery_form']/h4" position="replace">
      <h4 class="mb-4">Choose a Delivery method</h4>
    </xpath>
  </template>

  <template id="lx_delivery_form_free_mode" inherit_id="website_sale.delivery_form" name="Luxtor Delivery Free Mode">
    <xpath expr="//form[@id='o_delivery_form']" position="attributes">
      <attribute name="t-if">not lx_free_applies</attribute>
    </xpath>

    <xpath expr="//form[@id='o_delivery_form']" position="before">
      <div
        t-if="lx_free_applies"
        id="lx_free_delivery_info"
        class="lx-info-banner mt-3 mb-2"
        role="status"
      >
        Congratulations! Free Delivery has been successfully applied to your order.
      </div>
    </xpath>
  </template>

  <template id="lx_delivery_offer_panel" inherit_id="website_sale.delivery_form" name="Luxtor Delivery Offer Panel">
    <xpath expr="//form[@id='o_delivery_form']" position="after">
      <t t-set="lx_delivery_free_threshold" t-value="float(request.env['ir.config_parameter'].sudo().get_param('luxtor.lx_free_amount_order', default='5000') or 5000.0)"/>
      <div class="lx-delivery-offer-wrap mt-4">
        <div class="lx-delivery-offer-heading mb-2">Offer</div>
        <div class="lx-delivery-offer-box">
          <div class="lx-delivery-offer-line">
            <div class="lx-delivery-offer-icon" aria-hidden="true">
              <span class="lx-delivery-offer-dot" aria-hidden="true"/>
            </div>
            <div class="lx-delivery-offer-text">
              <div class="lx-delivery-offer-main">
                Free Delivery on orders above
                <span t-out="lx_delivery_free_threshold" t-options="{'widget': 'monetary', 'display_currency': order.currency_id}"/>.
              </div>
              <div class="lx-delivery-offer-sub">
                Depending on your location, your order will arrive within 24-48 hours.
              </div>
            </div>
          </div>
          <div class="lx-delivery-offer-learn mt-2">
            <a href="#o_delivery_form" class="lx-delivery-offer-link">Learn more</a>
          </div>
        </div>
      </div>
    </xpath>
  </template>

  <template id="lx_delivery_method_structure" inherit_id="website_sale.delivery_method" name="Luxtor Delivery Method Structure">
    <xpath expr="//div[hasclass('d-flex')]" position="attributes">
      <attribute name="class" add="lx-delivery-row align-items-center p-4" separator=" "/>
    </xpath>

    <xpath expr="//div[hasclass('form-check')]" position="attributes">
      <attribute name="class" add="lx-delivery-check" separator=" "/>
    </xpath>

    <xpath expr="//label[@name='o_delivery_method_label']" position="attributes">
      <attribute name="class" add="lx-delivery-label d-block" separator=" "/>
    </xpath>

    <xpath expr="//span[@name='o_delivery_method_name']" position="attributes">
      <attribute name="class" add="lx-delivery-name d-block" separator=" "/>
    </xpath>

    <xpath expr="//span[@name='o_delivery_method_name']" position="after">
      <div class="lx-delivery-subtitle mt-2">
        <t t-if="(dm.name or '').strip().lower().startswith('express')">Livraison prioritaire, assuree par</t>
        <t t-else="">Livraison rapide, assuree par</t>
        <span class="lx-delivery-provider-tag ms-2">
          <t t-if="dm.lx_carrier == 'cathedis'">Cathedis</t>
          <t t-elif="dm.lx_carrier == 'amana'">AMANA</t>
          <t t-else="">
            <t t-esc="dm.lx_get_carrier_display_name()"/>
          </t>
        </span>
      </div>
    </xpath>

    <xpath expr="//span[@name='price']" position="attributes">
      <attribute name="class" add="lx-delivery-price-badge" separator=" "/>
    </xpath>
  </template>
</odoo>
