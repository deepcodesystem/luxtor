<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>

        <!-- ================================================= -->
        <!-- SHIPPING RATE (STANDARD – CITY / ZIP)             -->
        <!-- ================================================= -->

        <!-- List view -->
        <record id="view_shipping_rate_list" model="ir.ui.view">
            <field name="name">shipping.rate.list</field>
            <field name="model">shipping.rate</field>
            <field name="arch" type="xml">
                <list string="Standard Delivery – City Rates" editable="bottom">
                    <field name="name"/>
                    <field name="province"/>
                    <field name="zip_code"/>
                    <field name="delivery_eta"/>
                    <field name="is_intracity"/>
                </list>
            </field>
        </record>

        <!-- Form view -->
        <record id="view_shipping_rate_form" model="ir.ui.view">
            <field name="name">shipping.rate.form</field>
            <field name="model">shipping.rate</field>
            <field name="arch" type="xml">
                <form string="Standard Delivery – City Rate">
                    <sheet>
                        <group>
                            <field name="name"/>
                            <field name="province"/>
                        </group>
                        <group>
                            <field name="zip_code"/>
                            <field name="delivery_eta"/>
                        </group>
                        <group>
                            <field name="price"/>
                            <field name="is_intracity"/>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

        <!-- Action -->
        <record id="action_shipping_rate" model="ir.actions.act_window">
            <field name="name">Standard Delivery (City)</field>
            <field name="res_model">shipping.rate</field>
            <field name="view_mode">list,form</field>
            <field name="view_id" ref="view_shipping_rate_list"/>
        </record>

        <!-- Menu -->
        <menuitem id="menu_shipping_rate"
                  name="Standard Delivery (City)"
                  parent="sale.menu_sale_config"
                  action="action_shipping_rate"
                  sequence="30"/>


        <!-- ================================================= -->
        <!-- DELIVERY BRACKETS (EXPRESS – WEIGHT)              -->
        <!-- ================================================= -->

        <!-- List view -->
        <record id="view_delivery_bracket_lx_list" model="ir.ui.view">
            <field name="name">delivery.bracket.lx.list</field>
            <field name="model">delivery.bracket.lx</field>
            <field name="arch" type="xml">
                <list string="Express Delivery – Weight Brackets" editable="bottom">
                    <field name="carrier_id"/>
                    <field name="kind"/>
                    <field name="min_kg"/>
                    <field name="max_kg"/>
                    <field name="unit_price"/>
                </list>
            </field>
        </record>

        <!-- Form view -->
        <record id="view_delivery_bracket_lx_form" model="ir.ui.view">
            <field name="name">delivery.bracket.lx.form</field>
            <field name="model">delivery.bracket.lx</field>
            <field name="arch" type="xml">
                <form string="Express Delivery – Weight Bracket">
                    <sheet>
                        <group>
                            <field name="carrier_id"/>
                            <field name="kind"/>
                        </group>
                        <group>
                            <field name="min_kg"/>
                            <field name="max_kg"/>
                            <field name="unit_price"/>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

        <!-- Action -->
        <record id="action_delivery_bracket_lx" model="ir.actions.act_window">
            <field name="name">Express Delivery (Weight)</field>
            <field name="res_model">delivery.bracket.lx</field>
            <field name="view_mode">list,form</field>
            <field name="view_id" ref="view_delivery_bracket_lx_list"/>
        </record>

        <!-- Menu -->
        <menuitem id="menu_delivery_bracket_lx"
                  name="Express Delivery (Weight)"
                  parent="sale.menu_sale_config"
                  action="action_delivery_bracket_lx"
                  sequence="35"/>

    </data>
</odoo>
