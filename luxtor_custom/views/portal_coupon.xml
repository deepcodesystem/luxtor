<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <template id="portal_my_home_welcome_coupon"
              inherit_id="portal.portal_my_home"
              name="Portal Welcome Coupon Card">
        <xpath expr="//div[contains(@class, 'o_portal_docs')]" position="inside">
            <t t-if="lx_welcome_coupon_code and not lx_welcome_coupon_applied">
                <div class="o_portal_index_card col-12 shadow-sm"
                     style="border-radius:0.75rem;background:#f8fbff;margin:20px auto;padding:20px 24px;border:1px solid #d7e8f7;">
                    <div class="card-body text-center">
                        <div class="mb-2">
                            <i class="fa fa-gift fa-2x text-primary"/>
                        </div>
                        <h5 class="fw-bold">Congratulations!</h5>
                        <p class="text-muted mb-0">
                            You've unlocked a
                            <span class="fw-bold"><t t-esc="lx_welcome_coupon_value_label or lx_welcome_coupon_value"/>%</span>
                            welcome discount for your first purchase.
                        </p>
                        <div class="mt-3">
                            <code class="fw-bold fs-6" t-esc="lx_welcome_coupon_code"/>
                        </div>
                        <div class="mt-3">
                            <a href="/shop/cart" class="btn btn-sm btn-outline-primary">Apply it in your cart</a>
                        </div>
                    </div>
                </div>
            </t>
        </xpath>
    </template>
</odoo>
