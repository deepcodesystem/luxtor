<?xml version="1.0" encoding="UTF-8"?>
<odoo>

  <record id="view_lx_affiliate_click_tree" model="ir.ui.view">
    <field name="name">lx.affiliate.click.tree</field>
    <field name="model">lx.affiliate.click</field>
    <field name="arch" type="xml">
      <list string="Affiliate Clicks" default_order="create_date desc">
        <field name="create_date"/>
        <field name="session_key"/>
        <field name="artisan_slug"/>
        <field name="artisan_id"/>
        <field name="sale_order_id"/>
        <field name="ip"/>
      </list>
    </field>
  </record>

    <record id="view_lx_affiliate_click_form" model="ir.ui.view">
    <field name="name">lx.affiliate.click.form</field>
    <field name="model">lx.affiliate.click</field>
    <field name="arch" type="xml">
      <form string="Affiliate Click Trace">
        <sheet>

          <group>
            <group>
              <field name="create_date" readonly="1"/>
              <field name="session_key" readonly="1"/>
              <field name="ip" readonly="1"/>
              <field name="user_agent" readonly="1"/>
            </group>

            <group>
              <field name="artisan_slug" readonly="1"/>
              <field name="artisan_id" readonly="1"/>
              <field name="sale_order_id" readonly="1"/>
              <field name="url" readonly="1"/>
            </group>
          </group>

          <notebook>
            <page string="Payload JSON">
              <field name="payload_json" readonly="1" nolabel="1"/>
            </page>
          </notebook>

        </sheet>
      </form>
    </field>
  </record>
  <record id="action_lx_affiliate_click" model="ir.actions.act_window">
    <field name="name">Affiliate Clicks</field>
    <field name="res_model">lx.affiliate.click</field>
    <field name="view_mode">list,form</field>
    <field name="help" type="html">
      <p class="o_view_nocontent_smiling_face">
        No affiliate clicks recorded yet.
      </p>
    </field>
  </record>

</odoo>