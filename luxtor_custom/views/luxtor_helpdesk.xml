  <record id="view_helpdesk_ticket_form_inherit_verif_code" model="ir.ui.view">
    <field name="name">helpdesk.ticket.form.verif.code.chatter</field>
    <field name="model">helpdesk.ticket</field>
    <field name="inherit_id" ref="helpdesk.helpdesk_ticket_view_form"/>
    <field name="arch" type="xml">
      <!-- Ajouter le bouton dans le chatter -->
      

      <xpath expr="//header" position="inside">
                <button name="action_verification_code"
                        string="Generate code"
                        type="object"
                        class="btn-secondary"
                        />
                <button name="action_send_verification_code_email"
                        string="Send code by email"
                        type="object"
                        class="btn-secondary"
                        />
        </xpath>

        <!-- Readonly field in the sheet to show the latest code -->
        <xpath expr="//sheet//group" position="inside">
            <group>
            <field name="lx_verification_code" readonly="1" invisible="1"/>
            <field name="lx_verif_token" readonly="1" invisible="1"/>
            <field name="lx_sale_order_id" readonly="1" invisible="1"/>
            </group>
            <group string="Verification Follow-up">
            <field name="lx_code_email_sent_to" readonly="1"/>
            <field name="lx_code_email_sent_at" readonly="1"/>
            </group>
        </xpath>
    </field>
  </record>
</odoo>
