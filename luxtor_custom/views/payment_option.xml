<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <template id="payment_method_form_subtitle"
          inherit_id="payment.method_form">

    <xpath expr="//label[contains(@class, 'o_payment_option_label')]"
           position="after">

        <t t-if="pm_sudo.name in ('100% on Order', '50% on Order &amp; 50% on Delivery')">
            <br/>
            <div style="margin-top:2px;font-size:0.95rem;color:#C98B2A;">
                Paiement par Carte Bancaire
            </div>
        </t>

    </xpath>

</template>
</odoo>
