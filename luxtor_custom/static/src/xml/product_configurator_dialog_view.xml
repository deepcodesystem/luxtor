<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!--
        This template extends the standard Product Configurator dialog
        to add custom input fields for width and height.
    -->
    <template id="luxtor_product_configurator_dialog_extend_final"
              inherit_id="sale.product_configurator_dialog"
              priority="20">
        <!--
            We use an xpath expression to precisely position the custom fields
            before the existing quantity input, which is a reliable position
            within the dialog's structure.
        -->
        <xpath expr="//div[@name='o_sale_product_configurator_name']" position="after">
            <!-- Container for our custom fields -->
            <div class="o_demo_custom_block p-2" style="border:1px dashed #bbb; margin-bottom:10px;">
                <div class="row">
                    <!-- Input field for Width -->
                    <div class="col-6">
                        <label for="widthInput" class="form-label">Width (m)</label>
                        <input
                            id="widthInput"
                            t-ref="width"
                            type="number"
                            class="form-control"
                            t-att-value="props.product.width || '0.0'"
                            t-on-input="() => this.onCustomFieldChange('width', $event)"
                            step="0.01"
                            min="0"
                        />
                    </div>
                    <!-- Input field for Height -->
                    <div class="col-6">
                        <label for="heightInput" class="form-label">Height (m)</label>
                        <input
                            id="heightInput"
                            t-ref="height"
                            type="number"
                            class="form-control"
                            t-att-value="props.product.height || '0.0'"
                            t-on-input="() => this.onCustomFieldChange('height', $event)"
                            step="0.01"
                            min="0"
                        />
                    </div>
                </div>
            </div>
        </xpath>
    </template>
</odoo>