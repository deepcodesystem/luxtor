<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
  <!-- Extend OWL Product Configurator form -->
  <t t-extend="sale.ProductConfigurator">
    <t t-jquery="div[name='o_sale_product_configurator_name']" t-operation="after">
      <div class="o_configurator_dimensions oe_inline align-items-start gap-3" t-attf-data-lx="1">
        <div class="form-group">
          <label for="lx_cfg_width_input">Width (m)</label>
          <input type="number" step="0.01" min="0" id="lx_cfg_width_input" class="form-control"
                 placeholder="" autocomplete="off"/>
          <div id="lx_cfg_width_hint" class="text-muted small mt-1"></div>
          <div class="lx-validate-msg text-danger small mt-2" data-for="lx_cfg_width_input" style="display:none;"></div>
        </div>
        <div class="form-group">
          <label for="lx_cfg_height_input">Height (m)</label>
          <input type="number" step="0.01" min="0" id="lx_cfg_height_input" class="form-control"
                 placeholder="" autocomplete="off"/>
          <div id="lx_cfg_height_hint" class="text-muted small mt-1"></div>
          <div class="lx-validate-msg text-danger small mt-2" data-for="lx_cfg_height_input" style="display:none;"></div>
        </div>
      </div>
    </t>
  </t>
</templates>
