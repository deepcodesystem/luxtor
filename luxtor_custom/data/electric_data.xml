<?xml version="1.0" encoding="UTF-8"?>
<odoo >
    <data noupdate="1">
            <record id="param_luxtor_motor_code" model="ir.config_parameter">
                <field name="key">luxtor.motor_code</field>
                <field name="value">MOTOR_28MM_230V</field>
            </record>

            <record id="param_luxtor_remote_code" model="ir.config_parameter">
                <field name="key">luxtor.remote_code</field>
                <field name="value">REMOTE_15CH</field>
            </record>

            <record id="param_luxtor_charger_code" model="ir.config_parameter">
                <field name="key">luxtor.charger_code</field>
                <field name="value">CHARGER_LIION</field>
            </record>

            <!-- Ratios  logic -->
            <record id="param_luxtor_remote_ratio" model="ir.config_parameter">
                <field name="key">luxtor.remote_ratio</field>
                <field name="value">5</field>
            </record>

            <record id="param_luxtor_charger_ratio" model="ir.config_parameter">
                <field name="key">luxtor.charger_ratio</field>
                <field name="value">15</field>
            </record>
    </data>
</odoo>
