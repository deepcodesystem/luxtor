<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <data noupdate="1">

<!-- Action Server: Weekly Deal -->
<record id="lx_snippet_action_weekly_deal" model="ir.actions.server">
    <field name="name">LX Weekly Deal Products</field>
    <field name="model_id" ref="model_product_product"/>
    <field name="state">code</field>
    <field name="code">
DynamicFilter = model.env['website.snippet.filter']
res_products = DynamicFilter._get_products('lx_weekly_deal')
for data in res_products:
    data['_lx_weekly_deal'] = True
response = res_products
    </field>
</record>

<!-- Action Server: New In -->
<record id="lx_snippet_action_new_in" model="ir.actions.server">
    <field name="name">LX New In Products</field>
    <field name="model_id" ref="model_product_product"/>
    <field name="state">code</field>
    <field name="code">
DynamicFilter = model.env['website.snippet.filter']
res_products = DynamicFilter._get_products('lx_new_in')
for data in res_products:
    data['_lx_new_in'] = True
response = res_products
    </field>
</record>

<record id="lx_snippet_filter_weekly_deal" model="website.snippet.filter">
    <field name="action_server_id" ref="luxtor_custom.lx_snippet_action_weekly_deal"/>
    <field name="field_names">display_name,description_sale,image_512</field>
    <field name="limit" eval="16"/>
    <field name="name">LX - Weekly Deal</field>
</record>

<record id="lx_snippet_filter_new_in" model="website.snippet.filter">
    <field name="action_server_id" ref="luxtor_custom.lx_snippet_action_new_in"/>
    <field name="field_names">display_name,description_sale,image_512</field>
    <field name="limit" eval="16"/>
    <field name="name">LX - New In</field>
</record>
  </data>
</odoo>
