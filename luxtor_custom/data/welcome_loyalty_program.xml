<?xml version="1.0" encoding="UTF-8"?>
<odoo noupdate="1">
    <!--
        Welcome coupon loyalty program.
        program_type='coupons': one personal card per customer, redeemed by entering a code.
        trigger='with_code': customer types the code in the cart/checkout code field.
        applies_on='current': discount applied to the order in which the code is entered.
        reward.discount=5: matches the default luxtor.lx_welcome_reward_pct setting (5%).

        noupdate="1": created once on install; admin can adjust discount % and name freely
        without the module upgrade resetting them.  If you change lx_welcome_reward_pct
        in Settings, also update the reward.discount field here to keep them in sync.
    -->
    <record id="loyalty_program_welcome" model="loyalty.program">
        <field name="name">WELCOME</field>
        <field name="program_type">coupons</field>
        <field name="trigger">with_code</field>
        <field name="applies_on">current</field>
        <field name="active">True</field>
    </record>

    <record id="loyalty_reward_welcome_pct" model="loyalty.reward">
        <field name="program_id" ref="loyalty_program_welcome"/>
        <field name="reward_type">discount</field>
        <field name="discount_mode">percent</field>
        <field name="discount">5</field>
        <field name="discount_applicability">order</field>
        <field name="required_points">1</field>
    </record>
</odoo>
