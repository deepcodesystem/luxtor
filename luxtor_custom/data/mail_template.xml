<?xml version="1.0" encoding="UTF-8"?>
<odoo>
  <record id="mail_template_sale_order_customer_confirm" model="mail.template">
    <field name="name">Luxtor: Order Confirmation</field>
    <field name="model_id" ref="sale.model_sale_order"/>
    <field name="subject">
        {{ object.company_id.name }}: Confirmation de commande {{ object.name }}
    </field>
    <field name="body_html" type="html">
        <div style="font-family:Arial, Helvetica, sans-serif; font-size:14px; color:#111;">
            <p>Bonjour <strong t-out="object.partner_id.display_name or 'Client'"/></p>
            <p>
                Félicitations ! Votre commande <strong t-out="object.name"/> auprès de
                <strong t-out="object.company_id.name"/> a été confirmée avec succès pour un montant
                total de <strong t-out="format_amount(object.amount_total, object.currency_id)"/>.
            </p>
            <p>
                Pour suivre votre commande :<br/>
                <a t-att-href="object.get_base_url() + object.get_portal_url()"
                   target="_blank"
                   style="color:#2F7CB9; text-decoration:underline;">Suivre ma commande</a>
                <br/>
                <span style="font-size:12px; color:#555;"
                      t-out="object.get_base_url() + object.get_portal_url()"/>
            </p>
            <p>Merci.</p>
        </div>
    </field>
    <field name="lang">{{ object.partner_id.lang }}</field>
    <field name="auto_delete" eval="True"/>
</record>

<record id="mail_template_sale_order_limit_code" model="mail.template">
    <field name="name">Luxtor: Vérification commande (Code)</field>
    <field name="model_id" ref="sale.model_sale_order"/>
    <field name="subject">
        {{ object.company_id.name }}: Code de validation pour la commande {{ object.name }}
    </field>
    <field name="body_html" type="html">
        <div style="font-family:Arial, Helvetica, sans-serif; font-size:14px; color:#111;">
            <p>Bonjour <strong t-out="object.partner_id.display_name or 'Client'"/></p>
            <p>
                Veuillez saisir le code suivant pour continuer :
            </p>
            <p style="font-size:22px; font-weight:bold;">
                <t t-out="object.lx_verification_code"/>
            </p>
            
            <p>Merci.</p>
        </div>
    </field>
    <field name="lang">{{ object.partner_id.lang }}</field>
    <field name="auto_delete" eval="True"/>
  </record>

  <record id="mail_template_helpdesk_verification_code" model="mail.template">
    <field name="name">Luxtor: Helpdesk Verification Code</field>
    <field name="model_id" ref="helpdesk.model_helpdesk_ticket"/>
    <field name="subject">
        {{ object.company_id.name if object.company_id else 'Luxtor' }}: Your authorization code for ticket {{ object.display_name }}
    </field>
    <field name="body_html" type="html">
        <div style="font-family:Arial, Helvetica, sans-serif; font-size:14px; color:#111;">
            <p>Hello <strong t-out="object.partner_id.display_name or 'Customer'"/></p>
            <p>Your authorization code is:</p>
            <p style="font-size:28px; font-weight:700; letter-spacing:4px; margin:16px 0;">
                <t t-out="object.lx_verification_code"/>
            </p>
            <p t-if="object.lx_sale_order_id">
                Order reference:
                <strong t-out="object.lx_sale_order_id.name"/>
            </p>
            <p>Enter this code in your cart to continue to checkout.</p>
            <p>Thank you.</p>
        </div>
    </field>
    <field name="lang">{{ object.partner_id.lang }}</field>
    <field name="auto_delete" eval="True"/>
  </record>

  <record id="mail_template_welcome_coupon" model="mail.template">
    <field name="name">Luxtor: Welcome Coupon</field>
    <field name="model_id" ref="base.model_res_partner"/>
    <field name="subject">
        Welcome to {{ object.company_id.name if object.company_id else 'Luxtor' }} - Your discount code
    </field>
    <field name="email_to">{{ object.email or '' }}</field>
    <field name="body_html" type="html">
        <div style="font-family:Arial, Helvetica, sans-serif; font-size:14px; color:#111;">
            <p>Hello <strong t-out="object.display_name or 'Customer'"/></p>
            <p>Thank you for creating your account.</p>
            <p>
                Here is your personal welcome discount:
                <strong t-out="ctx.get('coupon_value', 5)"/>%
            </p>
            <p style="font-size:22px; font-weight:bold; letter-spacing:2px;">
                <t t-out="ctx.get('coupon_code', '')"/>
            </p>
            <p>You can apply this code in your cart or at checkout.</p>
            <p>Thank you.</p>
        </div>
    </field>
    <field name="lang">{{ object.lang }}</field>
    <field name="auto_delete" eval="True"/>
  </record>

</odoo>
