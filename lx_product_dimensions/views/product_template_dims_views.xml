<odoo>
  <record id="view_product_template_dims" model="ir.ui.view">
    <field name="name">product.template.form.lx.dims</field>
    <field name="model">product.template</field>
    <field name="inherit_id" ref="product.product_template_only_form_view"/>
    <field name="arch" type="xml">

      <xpath expr="//sheet/notebook" position="inside">

        <!-- ── Luxtor tab (Data + Config) ─────────────────────────── -->
        <page string="Luxtor" name="lx_dims_data">
          <group col="2">

            <group string="COMPUTATION">
              <label for="waste_rate"/>
              <div class="o_row">
                <field name="waste_rate" nolabel="1" class="oe_inline"/>
                <span class="ms-2">%</span>
              </div>
              <label for="added_margin"/>
              <div class="o_row">
                <field name="added_margin" nolabel="1" class="oe_inline"/>
                <span class="ms-2">%</span>
              </div>
              <label for="fabric_allowance"/>
              <div class="o_row">
                <field name="fabric_allowance" nolabel="1" class="oe_inline"/>
                <span class="ms-2">cm</span>
              </div>
              <label for="remenant_threshold"/>
              <div class="o_row">
                <field name="remenant_threshold" nolabel="1" class="oe_inline"/>
                <span class="ms-2">cm</span>
              </div>
              <label for="remenant_tolerence"/>
              <div class="o_row">
                <field name="remenant_tolerence" nolabel="1" class="oe_inline"/>
                <span class="ms-2">%</span>
              </div>
            </group>

            <group string="TECHNICAL">
              <label for="roller_width_ids"/>
              <div class="o_row">
                <field name="roller_width_ids" nolabel="1" widget="many2many_tags" class="oe_inline"/>
                <span class="ms-2">cm</span>
              </div>
              <label for="maximum_load"/>
              <div class="o_row">
                <field name="maximum_load" nolabel="1" class="oe_inline"/>
                <span class="ms-2">kg</span>
              </div>
              <label for="openness_factor_id"/>
              <div class="o_row">
                <field name="openness_factor_id" nolabel="1" class="oe_inline"/>
                <span class="ms-2">%</span>
              </div>
              <label for="color_fastness_id"/>
              <div class="o_row">
                <field name="color_fastness_id" nolabel="1" class="oe_inline"/>
                <span class="ms-2">grade</span>
              </div>
              <label for="lx_fabric_ref_id"/>
              <div class="o_row">
                <field name="lx_fabric_ref_id" nolabel="1" options="{'no_create_edit': False}"/>
              </div>
              <label for="lx_weight"/>
              <div class="o_row">
                <field name="lx_weight" nolabel="1" class="oe_inline"/>
                <span class="ms-2">g/m²</span>
              </div>
            </group>

          </group>

          <!-- ── Config row ───────────────────────────────────────── -->
          <group col="2">
            <group string="CONFIGURATION">
              <label for="max_height"/>
              <div class="o_row">
                <field name="max_height" nolabel="1" readonly="1" class="oe_inline"/>
                <span class="ms-2">m</span>
              </div>
              <label for="width_cm"/>
              <div class="o_row">
                <field name="width_cm" nolabel="1" readonly="1" class="oe_inline"/>
                <span class="ms-2">cm</span>
              </div>
              <field name="is_dimension_product"/>
              <field name="lx_qty_by_width"/>
              <field name="lx_qty_by_height"/>
            </group>

            <!-- ── Component Flags (grille 3 colonnes) ──────────── -->
            <group string="COMPONENT FLAGS" col="6">
              <field name="is_mounting_bracket"/>
              <field name="lx_is_day_night"/>
              <field name="lx_is_fabric"/>
              <field name="lx_is_cassette"/>
              <field name="lx_is_roller_tube"/>
              <field name="lx_is_bottom_rail"/>
              <field name="lx_is_inner_tube"/>
              <field name="lx_is_roller_mechanism"/>
              <field name="lx_is_plastic_chain"/>
            </group>
          </group>

        </page>

      </xpath>
    </field>
  </record>
</odoo>

