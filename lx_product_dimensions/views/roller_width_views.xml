<odoo>
  <record id="view_roller_width_list" model="ir.ui.view">
    <field name="name">roller.width.list</field>
    <field name="model">roller.width</field>
    <field name="arch" type="xml">
      <list>
        <field name="sequence" widget="handle"/>
        <field name="name"/>
        <field name="value_cm"/>
        <field name="active" column_invisible="1"/>
      </list>
    </field>
  </record>

  <record id="view_roller_width_form" model="ir.ui.view">
    <field name="name">roller.width.form</field>
    <field name="model">roller.width</field>
    <field name="arch" type="xml">
      <form>
        <sheet>
          <group>
            <field name="name"/>
            <field name="sequence"/>
            <field name="value_cm" readonly="1"/>
            <field name="active"/>
          </group>
        </sheet>
      </form>
    </field>
  </record>

  <record id="action_roller_width" model="ir.actions.act_window">
    <field name="name">Roller Width Tags</field>
    <field name="res_model">roller.width</field>
    <field name="view_mode">list,form</field>
  </record>
</odoo>

