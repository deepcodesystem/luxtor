<odoo>
  <!-- ── Openness Factor ─────────────────────────────────────────── -->
  <record id="view_product_openness_factor_list" model="ir.ui.view">
    <field name="name">product.openness.factor.list</field>
    <field name="model">product.openness.factor</field>
    <field name="arch" type="xml">
      <list>
        <field name="name"/>
        <field name="active" column_invisible="1"/>
      </list>
    </field>
  </record>

  <record id="view_product_openness_factor_form" model="ir.ui.view">
    <field name="name">product.openness.factor.form</field>
    <field name="model">product.openness.factor</field>
    <field name="arch" type="xml">
      <form>
        <sheet>
          <group>
            <field name="name"/>
            <field name="active"/>
          </group>
        </sheet>
      </form>
    </field>
  </record>

  <record id="action_product_openness_factor" model="ir.actions.act_window">
    <field name="name">Openness Factors</field>
    <field name="res_model">product.openness.factor</field>
    <field name="view_mode">list,form</field>
  </record>

  <!-- ── Color Fastness ─────────────────────────────────────────── -->
  <record id="view_product_color_fastness_list" model="ir.ui.view">
    <field name="name">product.color.fastness.list</field>
    <field name="model">product.color.fastness</field>
    <field name="arch" type="xml">
      <list>
        <field name="name"/>
        <field name="active" column_invisible="1"/>
      </list>
    </field>
  </record>

  <record id="view_product_color_fastness_form" model="ir.ui.view">
    <field name="name">product.color.fastness.form</field>
    <field name="model">product.color.fastness</field>
    <field name="arch" type="xml">
      <form>
        <sheet>
          <group>
            <field name="name"/>
            <field name="active"/>
          </group>
        </sheet>
      </form>
    </field>
  </record>

  <record id="action_product_color_fastness" model="ir.actions.act_window">
    <field name="name">Color Fastness</field>
    <field name="res_model">product.color.fastness</field>
    <field name="view_mode">list,form</field>
  </record>

  <!-- ── Composition ──────────────────────────────────────────────── -->
  <record id="view_product_composition_list" model="ir.ui.view">
    <field name="name">product.composition.list</field>
    <field name="model">product.composition</field>
    <field name="arch" type="xml">
      <list>
        <field name="name"/>
        <field name="active" column_invisible="1"/>
      </list>
    </field>
  </record>

  <record id="view_product_composition_form" model="ir.ui.view">
    <field name="name">product.composition.form</field>
    <field name="model">product.composition</field>
    <field name="arch" type="xml">
      <form>
        <sheet>
          <group>
            <field name="name"/>
            <field name="note"/>
            <field name="active"/>
          </group>
        </sheet>
      </form>
    </field>
  </record>

  <record id="action_product_composition" model="ir.actions.act_window">
    <field name="name">Compositions</field>
    <field name="res_model">product.composition</field>
    <field name="view_mode">list,form</field>
  </record>
</odoo>

