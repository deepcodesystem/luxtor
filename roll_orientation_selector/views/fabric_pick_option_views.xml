<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_fabric_pick_option_list" model="ir.ui.view">
        <field name="name">fabric.pick.option.list</field>
        <field name="model">fabric.pick.option</field>
        <field name="arch" type="xml">
            <list decoration-success="is_recommended">
                <field name="name"/>
                <field name="production_id"/>
                <field name="product_id"/>
                <field name="option_type"/>
                <field name="remnant_id"/>
                <field name="lot_id"/>
                <field name="dimension_minmax_label"/>
                <field name="roll_width_m"/>
                <field name="orientation"/>
                <field name="remnant_area_m2"/>
                <field name="waste_area_m2"/>
                <field name="is_recommended"/>
            </list>
        </field>
    </record>

    <record id="view_fabric_pick_option_form" model="ir.ui.view">
        <field name="name">fabric.pick.option.form</field>
        <field name="model">fabric.pick.option</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group>
                            <field name="display_label"/>
                            <field name="production_id"/>
                            <field name="product_id"/>
                            <field name="option_type"/>
                            <field name="is_recommended"/>
                        </group>
                        <group>
                            <field name="remnant_id"/>
                            <field name="lot_id"/>
                            <field name="dimension_minmax_label"/>
                            <field name="roll_width_m"/>
                            <field name="orientation"/>
                            <field name="remnant_area_m2"/>
                            <field name="waste_area_m2"/>
                        </group>
                    </group>
                    <group>
                        <field name="tooltip" readonly="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_fabric_pick_options" model="ir.actions.act_window">
        <field name="name">Fabric Pick Options</field>
        <field name="res_model">fabric.pick.option</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
