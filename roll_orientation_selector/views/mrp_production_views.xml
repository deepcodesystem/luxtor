<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_mrp_production_form_roll_orientation_selector" model="ir.ui.view">
        <field name="name">mrp.production.form.roll.orientation.selector</field>
        <field name="model">mrp.production</field>
        <field name="inherit_id" ref="mrp.mrp_production_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <button name="action_compute_fabric_pick_options" type="object" string="Compute Fabric Pick" class="btn-primary"/>
            </xpath>
            <xpath expr="//field[@name='product_id']" position="after">
                <field name="fabric_category_rule_id"/>
                <field name="fabric_order_width_m"/>
                <field name="fabric_order_height_m"/>
                <field name="fabric_layer_count"/>
                <field name="fabric_tolerance"/>
                <field name="fabric_allowance_m"/>
                <field name="fabric_pick_option_id" options="{'no_create': True}"/>
                <field name="fabric_pick_tooltip" readonly="1"/>
            </xpath>
        </field>
    </record>
</odoo>

