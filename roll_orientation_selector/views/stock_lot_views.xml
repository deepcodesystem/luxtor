<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_stock_lot_roll_selector_list" model="ir.ui.view">
        <field name="name">stock.lot.roll.selector.list</field>
        <field name="model">stock.lot</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="product_id"/>
                <field name="fabric_color"/>
                <field name="roll_width_m"/>
                <field name="is_fabric_roll"/>
                <field name="company_id" groups="base.group_multi_company"/>
            </list>
        </field>
    </record>

    <record id="view_stock_lot_roll_selector_form" model="ir.ui.view">
        <field name="name">stock.lot.roll.selector.form</field>
        <field name="model">stock.lot</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="product_id"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                        <group>
                            <field name="is_fabric_roll"/>
                            <field name="roll_width_m"/>
                            <field name="fabric_color"/>
                            <field name="roll_selector_label" readonly="1"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_fabric_roll_lots" model="ir.actions.act_window">
        <field name="name">Fabric Roll Lots</field>
        <field name="res_model">stock.lot</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('is_fabric_roll', '=', True)]</field>
        <field name="context">{'default_is_fabric_roll': True}</field>
    </record>
</odoo>

